{
  "schema_version": "agentic-workspace/release-ownership/v1",
  "release_model": "coordinated-workspace",
  "canonical_version_source": "pyproject.toml",
  "project_identity": {
    "name": "Agentic Workspace",
    "author": "Rickard von Haugwitz",
    "maintainer": "Rickard von Haugwitz",
    "license_spdx": "MIT",
    "license_file": "LICENSE",
    "homepage": "https://github.com/rickardvh/agentic-workspace",
    "repository": "https://github.com/rickardvh/agentic-workspace",
    "issues": "https://github.com/rickardvh/agentic-workspace/issues",
    "support": "https://github.com/rickardvh/agentic-workspace/issues",
    "maturity_classifier": "Development Status :: 3 - Alpha"
  },
  "distribution_identity": {
    "strategy": "exact-tagged-release-artifacts",
    "release_base_url_template": "https://github.com/rickardvh/agentic-workspace/releases/download/v{version}",
    "preview_release_base_url_template": "https://github.com/rickardvh/agentic-workspace/releases/download/preview-v{version}",
    "canonical_root_distribution": "agentic-workspace",
    "canonical_install_receipt": "distribution-install-readiness.json",
    "redistributable_receipt": "redistributable-package-readiness.json",
    "digest_algorithm": "sha256",
    "mutable_branch_install_supported": false,
    "registry_resolution_supported": true,
    "rule": "RC/stable language registries project the admitted GitHub artifact digests; only stable admission grants support. Exploratory previews remain GitHub-only.",
    "release_candidate_base_url_template": "https://github.com/rickardvh/agentic-workspace/releases/download/{tag}",
    "platform_policy": ".github/release-platforms.json"
  },
  "changeset_dir": ".release/changes",
  "release_notes_dir": ".release/releases",
  "preview_metadata_dir": ".release/previews",
  "release_pr_branch": "automation/coordinated-release",
  "publisher": {
    "workflow": ".github/workflows/release.yml",
    "trigger": "existing-tag-only",
    "tag_rule": "vMAJOR.MINOR.PATCH must point at a commit whose coordinated package manifests declare the same version"
  },
  "preview_publisher": {
    "workflow": ".github/workflows/preview-release.yml",
    "trigger": "workflow_dispatch on master with immutable preview tag and exact artifact SHA",
    "release_class": "preview",
    "support_bearing": false,
    "tag_rule": "preview-vMAJOR.MINOR.PATCH must point at a release-only commit whose single parent is the exact reconstruction source commit"
  },
  "semantic_conformance": {
    "required_for_support_bearing_typescript_release": true,
    "receipt_kind": "agentic-workspace/native-release-conformance/v1",
    "runtime_majors": [
      20,
      24,
      25
    ],
    "runner": "scripts/check/check_native_release_topology.py",
    "failure_policy": "missing, stale, mismatched, failed, or unsupported receipts block publication"
  },
  "support_bearing_promotion": {
    "policy": ".github/support-bearing-promotion.json",
    "checker": "scripts/release/support_bearing_promotion.py",
    "receipt_kind": "agentic-workspace/support-bearing-promotion/v1",
    "receipt": "support-bearing-promotion.json",
    "subject": "exact source commit and exact release artifact digests",
    "failure_policy": "missing, stale, mismatched, failed, or unsupported domain evidence blocks tagging and publication"
  },
  "semver_labels": [
    "semver:major",
    "semver:minor",
    "semver:patch"
  ],
  "release_commit_allowed_paths": [
    "pyproject.toml",
    ".agentic-workspace/payload-provenance.json",
    ".release/releases/",
    "uv.lock",
    ".release/changes/",
    ".release/promotions/v1.0.0.json",
    "crates/agentic-workspace-core/Cargo.toml",
    "crates/agentic-workspace-cli/Cargo.toml",
    "Cargo.lock",
    "tests/fixtures/native-independent-owner/Cargo.lock"
  ],
  "preview_release_commit_allowed_paths": [
    "pyproject.toml",
    ".agentic-workspace/payload-provenance.json",
    ".release/releases/",
    ".release/previews/",
    "uv.lock",
    "crates/agentic-workspace-core/Cargo.toml",
    "crates/agentic-workspace-cli/Cargo.toml",
    "Cargo.lock",
    "tests/fixtures/native-independent-owner/Cargo.lock"
  ],
  "package_affecting_paths": [
    ".release/changes/",
    ".release/releases/",
    "docs/release-and-versioning.md",
    "packages/",
    "pyproject.toml",
    "scripts/release/",
    "src/",
    "uv.lock",
    "Cargo.toml",
    "Cargo.lock",
    "crates/",
    "bindings/"
  ],
  "non_semver_generated_metadata": [],
  "packages": [
    {
      "name": "agentic-workspace",
      "pyproject": "pyproject.toml",
      "wheel_prefix": "agentic_workspace",
      "sdist_prefix": "agentic_workspace",
      "payload_schema": "agentic-workspace/payload/v1",
      "payload_provenance": ".agentic-workspace/payload-provenance.json",
      "proof_commands": [
        "make test-workspace",
        "make lint-workspace"
      ]
    }
  ],
  "typescript_packages": [
    {
      "name": "@agentic-workspace/workspace-cli",
      "package_json": "bindings/node/package.json",
      "package_root": "bindings/node",
      "tarball_prefix": "agentic-workspace-workspace-cli",
      "entrypoints": [
        "agentic-workspace"
      ],
      "python_package": "agentic-workspace",
      "runtime": "node",
      "runtime_requirement": "node>=20",
      "release_policy": "coordinated-public-registry",
      "registry_status": "trusted-publication-required"
    }
  ],
  "version_floor_rule": "The next coordinated version must be greater than every shipped package version, every AW coordinated-release vMAJOR.MINOR.PATCH tag, and every preview-vMAJOR.MINOR.PATCH package identity; tags from other package domains do not set the AW release floor.",
  "release_candidate": {
    "tag_pattern": "v1.0.0-rc.N (N is a positive canonical integer)",
    "target_stable_tag": "v1.0.0",
    "release_class": "release-candidate",
    "support_bearing": false,
    "python_version": "1.0.0rcN",
    "npm_version": "1.0.0-rc.N",
    "cargo_version": "1.0.0-rc.N",
    "native_version": "Python package version",
    "publisher": "preview-release.yml",
    "promotion_record": ".release/promotions/v1.0.0.json",
    "progression": "Contiguous rc.N for a new source; retries reuse the same immutable tag."
  },
  "registry_publisher": {
    "workflow": ".github/workflows/registry-release.yml",
    "environment": "package-registries",
    "classes": [
      "release-candidate",
      "stable"
    ],
    "python": "https://pypi.org",
    "npm": "https://registry.npmjs.org",
    "rc_npm_tag": "rc",
    "stable_npm_tag": "latest",
    "receipt": "registry-publication.json",
    "authority": "Same admitted immutable tagged artifact set; no registry rebuilds"
  },
  "cargo_packages": [
    {
      "name": "agentic-workspace-core",
      "path": "crates/agentic-workspace-core",
      "binary": "agentic-workspace-core"
    },
    {
      "name": "agentic-workspace-cli",
      "path": "crates/agentic-workspace-cli",
      "binary": "agentic-workspace"
    }
  ],
  "cargo_distribution": {
    "version_source": "canonical RC/stable package_versions.cargo",
    "order": [
      "agentic-workspace-core",
      "agentic-workspace-cli"
    ],
    "install": "Install both exact same-version crates, core first, into one Cargo root",
    "staging": "scripts/release/cargo_release.py",
    "manifest": "cargo-release-manifest.json",
    "bootstrap": "First versions require bounded manual publication before OIDC can be configured",
    "support": "Same admitted release host; RC remains non-support-bearing"
  },
  "cargo_lockfiles": [
    "Cargo.lock",
    "tests/fixtures/native-independent-owner/Cargo.lock"
  ]
}
