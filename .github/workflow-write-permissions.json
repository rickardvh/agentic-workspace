{
  "kind": "agentic-workspace/repository-workflow-write-permissions/v1",
  "allowed_write_permissions": {
    ".github/workflows/ci.yml": [
      "security-events"
    ],
    ".github/workflows/maintenance.yml": [
      "security-events"
    ],
    ".github/workflows/release.yml": [
      "security-events",
      "actions",
      "pull-requests"
    ]
  }
}
