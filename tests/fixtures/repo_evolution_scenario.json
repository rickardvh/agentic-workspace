{
  "kind": "agentic-workspace/repo-evolution-scenario/v1",
  "id": "configure-once-multi-change",
  "initial_state": "valid-configured-repository",
  "explicit_generic_maintenance_steps": 0,
  "steps": [
    {
      "id": "path-test-movement",
      "change_class": "path-and-test-movement",
      "expected_outcome": "semantic-decision",
      "owner_class": "scoped-instruction"
    },
    {
      "id": "structured-path-rename",
      "change_class": "mechanically-known-path-movement",
      "expected_outcome": "deterministic-owner-update-once",
      "owner_class": "ownership"
    },
    {
      "id": "generated-source-change",
      "change_class": "generated-derived-source",
      "expected_outcome": "deterministic-repair-once",
      "owner_class": "generated-projection"
    },
    {
      "id": "terminal-work-owner",
      "change_class": "completed-terminal-owner",
      "expected_outcome": "retired-from-live-authority",
      "owner_class": "planning-lifecycle"
    },
    {
      "id": "review-topology-change",
      "change_class": "branch-pr-topology",
      "expected_outcome": "stale-baseline-rejected",
      "owner_class": "review-topology"
    },
    {
      "id": "module-add-remove",
      "change_class": "module-capability-lifecycle",
      "expected_outcome": "stale-contribution-removed",
      "owner_class": "module-capability"
    },
    {
      "id": "rebuildable-manifest",
      "change_class": "reconstructable-cache-index-manifest",
      "expected_outcome": "rebuilt-from-stronger-records",
      "owner_class": "validation-manifest",
      "proof_ref": "tests/test_compact_command_runner.py::test_manifest_reconcile_repairs_interrupted_publish_without_rerunning_result"
    },
    {
      "id": "machine-proof-addition",
      "change_class": "new-operating-fact",
      "expected_outcome": "canonical-owner-candidate",
      "owner_class": "proof-route"
    },
    {
      "id": "agent-semantic-addition",
      "change_class": "new-semantic-operating-fact",
      "expected_outcome": "human-decision-and-owner-apply",
      "owner_class": "scoped-instruction"
    },
    {
      "id": "ordinary-fact",
      "change_class": "non-operating-repository-fact",
      "expected_outcome": "quiet",
      "owner_class": "outside-aw"
    },
    {
      "id": "deferred-pressure",
      "change_class": "safe-deferral",
      "expected_outcome": "unrelated-work-unblocked",
      "owner_class": "memory"
    },
    {
      "id": "equivalent-work-repeat",
      "change_class": "post-admission-repeat",
      "expected_outcome": "quiet-no-rediscovery",
      "owner_class": "scoped-instruction"
    }
  ],
  "expected_metrics": {
    "manual_aw_maintenance": 0,
    "semantic_user_decisions": 2,
    "redundant_rediscovery": 0,
    "destination_owner_class_minimum": 3,
    "stable_first_line_cost": "none"
  },
  "failure_route": "Route a failed step to its existing currentness, lifecycle, topology, module, coverage, or semantic-decision owner; do not extend this scenario into a maintenance framework."
}
