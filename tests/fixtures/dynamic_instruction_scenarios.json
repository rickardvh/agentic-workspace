{
  "kind": "agentic-workspace/dynamic-instruction-scenarios/v1",
  "rule": "Behavior-level expectations are maintained independently of runtime field mappings; each scenario covers one distinct composition failure class.",
  "scenarios": [
    {
      "id": "planned-child-recall",
      "runner": "planning-route",
      "input": {"task_relation": "continues-selected-owner", "owner_posture": "current", "implementation_allowed": true},
      "expected": {"task_relation": "continues-selected-owner", "required_transition": "none"},
      "burden": {"max_output_bytes": 12000, "max_public_or_owner_calls": 3}
    },
    {
      "id": "unrelated-direct-work-precision",
      "runner": "operating-decision",
      "input": {"revisions": {"runtime": "r1"}, "terminal_state": "CONTINUE"},
      "expected": {"source_guidance_count": 0, "memory_contribution_count": 0},
      "burden": {"max_output_bytes": 12000, "max_public_or_owner_calls": 2}
    },
    {
      "id": "future-reader-freshness-admission",
      "runner": "incompatible-runtime",
      "input": {"minimum_reader_epoch_delta": 1},
      "expected": {"status": "blocking-drift", "triage_status": "claim_blocking", "changed_signal": "cli_compatibility=blocking-drift"},
      "burden": {"max_output_bytes": 12000, "max_public_or_owner_calls": 2}
    },
    {
      "id": "blocking-source-has-causal-effect",
      "runner": "causal-block",
      "input": {"reason_code": "runtime-repository-contract-incompatible", "owner": "runtime compatibility"},
      "expected": {"installed_payload_dependency": "dependent", "claim_class": "installed-payload-behavior"},
      "burden": {"max_output_bytes": 12000, "max_public_or_owner_calls": 2}
    },
    {
      "id": "one-decision-coherence",
      "runner": "coherence",
      "input": {"revisions": {"planning": "r7", "proof": "p2"}, "terminal_state": "CONTINUE"},
      "expected": {"same_revision_same_identity": true},
      "burden": {"max_output_bytes": 12000, "max_public_or_owner_calls": 4}
    },
    {
      "id": "memory-remains-advisory-to-planning",
      "runner": "memory-boundary",
      "input": {"planning_revision": "planning-r2", "fact_id": "selected-owner-trap"},
      "expected": {"memory_status": "no-match", "authority_class": "advisory", "planning_revision": "planning-r2"},
      "burden": {"max_output_bytes": 16000, "max_public_or_owner_calls": 2}
    },
    {
      "id": "focused-procedure-route",
      "runner": "source-guidance",
      "input": {"surface": "skills", "task": "review the routed skill procedure"},
      "expected": {"status": "projected", "full_body_loaded": false, "contribution_count": 1, "source_ref": ".agentic-workspace/skills/workspace-startup/SKILL.md"},
      "burden": {"max_output_bytes": 3000, "max_public_or_owner_calls": 2}
    },
    {
      "id": "durable-architecture-route",
      "runner": "source-guidance",
      "input": {"surface": "architecture-principles", "task": "follow the generated runtime contract architecture"},
      "expected": {"status": "projected", "full_body_loaded": false, "contribution_count": 1, "source_ref": "SYSTEM_INTENT.md"},
      "burden": {"max_output_bytes": 3000, "max_public_or_owner_calls": 2}
    }
  ]
}
