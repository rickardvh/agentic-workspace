{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "rules": {
      "type": "object",
      "properties": {
        "canonical_dirs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 64
        },
        "task_board_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 64
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "note_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "canonical_home": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "last_confirmed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "valid_until": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "routes_from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 64
          },
          "semantic_routes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 64
          },
          "stale_when": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 64
          },
          "superseded_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 64
          },
          "contradicted_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 64
          },
          "task_relevance": {
            "enum": [
              "optional",
              "review-only"
            ]
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "native_decision": {
            "const": true
          },
          "decision_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 64
          },
          "disposition": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "retain",
                  "retire",
                  "promote"
                ]
              },
              "note_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "receiver": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "durable_facts": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "note_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "promotion_target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "promotion_trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "promotion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "demotion_or_expiry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "preferred_remediation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "elimination_target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "authority_class": {
            "const": "advisory"
          },
          "disposition": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "retain",
                  "retire",
                  "promote"
                ]
              },
              "note_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "receiver": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "additionalProperties": false,
        "required": [
          "summary",
          "note_ref",
          "authority_class"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "description": "Memory declarations. Selectors and exact dependencies are native inputs. Dates and selected fact review context are advisory, never admission. Disposition and native decision linkage are owner-produced and require current custody."
}
