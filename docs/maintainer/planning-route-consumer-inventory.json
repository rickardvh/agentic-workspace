{
  "kind": "agentic-workspace/planning-route-consumer-inventory/v1",
  "authority": "planning_safety_gate.route_decision",
  "action_authority": "route_decision.next_safe_action.operation_invocation",
  "consumers": {
    "startup": {"projection": "direct", "selector": "planning_route_decision"},
    "implement": {"projection": "direct", "selector": "planning_route_decision"},
    "preflight": {"projection": "resolve", "resolver": "planning_safety_gate.route_decision"},
    "summary": {"projection": "direct", "selector": "planning_route_decision"},
    "actionability": {"projection": "mechanical", "source": "route_decision.next_safe_action"},
    "skills": {"projection": "direct", "selector": "planning_route_decision"},
    "SkillSpec": {"projection": "mechanical", "source": "route_decision.action_identity"},
    "Planning handoff": {"projection": "resolve", "resolver": "summary.planning_route_decision"},
    "proof": {"projection": "resolve", "resolver": "summary.planning_route_decision"},
    "closeout": {"projection": "resolve", "resolver": "summary.planning_route_decision"},
    "generated targets": {"projection": "generated", "source": "workspace Python authority"},
    "external consumers": {"projection": "typed invocation", "source": "route_decision.action_identity"},
    "no-CLI fallback": {"projection": "fail-closed capsule", "source": "no-cli-policy.json"}
  },
  "required_identity": [
    "decision_id",
    "input_revision",
    "action_identity",
    "required_transition",
    "blocked_claims",
    "state_update_policy"
  ],
  "compatibility_removal": {
    "task_switch_reconciliation.status": "backgrounded diagnostic; derive relation/posture/transition from route_decision",
    "task_switch_reconciliation.recommended_next_action": "derive from route_decision.next_safe_action.action",
    "task_switch_reconciliation.blocked_claims": "derive from route_decision.blocked_claims",
    "task_switch_reconciliation.route_acknowledgement": "derive from route_decision.action_identity",
    "task_switch_reconciliation.permission": "derive from route_decision implementation and mutation authority",
    "manual WORKFLOW first-line routing": "replaced by digest-verified no-CLI recovery capsule"
  },
  "rule": "Domain detail may narrow but never widen the decision, action, effect, proof, or claim authority."
}
