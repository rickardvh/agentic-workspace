{
  "kind": "agentic-workspace/configured-orchestration-evaluation-matrix/v1",
  "lane": "#2696/#2700",
  "evidence_boundary": {
    "deterministic": "Canonical operation and receipt transitions are executable without provider credentials.",
    "behavioral": "Available agents must execute the projected operation; prose recognition does not pass.",
    "live_provider": "Unavailable routes remain explicit gaps and are never relabeled as simulated live proof."
  },
  "receipt_contract": {
    "result_kind": "agentic-workspace/assignment-lifecycle-result/v1",
    "required_fields": ["operation_id", "transition", "status", "outcome", "mutation_applied", "run_id", "artifact_refs"],
    "success_rule": "The expected operation id, transition, successful status/outcome, and owned artifacts must be present in command output.",
    "non_solution": "Final response text that names or promises the operation."
  },
  "routes": [
    {
      "id": "ordinary-nonlocal-export",
      "harness_scenario": "configured-orchestrator-ordinary-nonlocal",
      "prompt_activation_terms": [],
      "expected_operations": ["assignment.export"],
      "expected_states": ["handoff-prepared"],
      "required_artifact_kinds": ["agentic-workspace/assignment-export-packet/v1", "agentic-workspace/assignment-export-manifest/v1"],
      "local_product_mutation": "forbidden"
    },
    {
      "id": "binding-rejects-local-retention",
      "harness_scenario": "configured-orchestrator-reject-local-retention",
      "expected_operations": ["assignment.export"],
      "expected_states": ["handoff-prepared"],
      "local_product_mutation": "forbidden",
      "failure_id": "LOCAL_RETENTION_AFTER_BINDING_ASSIGNMENT"
    },
    {
      "id": "selected-current-direct",
      "harness_scenario": "configured-orchestrator-selected-current-quiet",
      "expected_operations": [],
      "expected_states": ["assigned-current-target"],
      "forbidden_artifacts": [".agentic-workspace/local/assignment-runs/**"],
      "local_product_mutation": "permitted-by-ordinary-gates"
    },
    {
      "id": "manual-return-lifecycle",
      "expected_operations": ["assignment.export", "assignment.import", "assignment.admit", "assignment.integrate"],
      "expected_states": ["handoff-prepared", "awaiting-admission", "admitted", "integrated"],
      "required_boundaries": [
        "ready prompt and packet come from assignment.export artifacts",
        "import does not admit returned work",
        "admission re-resolves current assignment, proof, scope, and mutation baseline",
        "worker-reported proof is not trusted",
        "integration requires current admitted state"
      ]
    }
  ],
  "failure_matrix": [
    {
      "case": "automatic-transport-unavailable-manual-allowed",
      "expected_operation": "assignment.export",
      "expected_result": "handoff-prepared",
      "forbidden_result": "local-execution"
    },
    {
      "case": "worker-refused-or-blocked",
      "expected_operation": "assignment.reassign",
      "expected_result": "superseded",
      "recovery": "new revision-bound target selection"
    },
    {
      "case": "stale-return-revision",
      "expected_operation": "assignment.import",
      "expected_result": "blocked",
      "reason_code": "assignment-revision-mismatch"
    },
    {
      "case": "malformed-return",
      "expected_operation": "assignment.import",
      "expected_result": "blocked",
      "recovery": "request a return matching the export packet contract"
    },
    {
      "case": "return-awaiting-admission",
      "expected_operation": "assignment.import",
      "expected_result": "awaiting-admission",
      "forbidden_result": "integrated"
    },
    {
      "case": "failed-or-stale-proof",
      "expected_operation": "assignment.admit",
      "expected_result": "blocked",
      "recovery": "refresh AW-owned proof and current authority"
    },
    {
      "case": "tie-or-uncertainty",
      "expected_operation": null,
      "expected_result": "shape-or-bounded-probe",
      "forbidden_result": "lexical-target-selection"
    },
    {
      "case": "no-safe-route",
      "expected_operation": null,
      "expected_result": "blocked",
      "forbidden_result": "local-execution"
    }
  ],
  "total_successful_completion_cost": {
    "kind": "agentic-workspace/total-successful-completion-cost-comparison/v1",
    "formula": "orchestrator_context + startup_and_assignment_commands + worker_context + transport + review + repair + retry + restart + proof",
    "unit": "normalized-cost-points",
    "comparisons": [
      {
        "id": "bounded-mechanical-docs",
        "delegated": {"context": 2, "commands": 2, "worker": 2, "transport": 1, "review": 1, "repair_retry_restart": 0, "proof": 1, "total": 9},
        "stay_local": {"context": 5, "commands": 1, "worker": 0, "transport": 0, "review": 2, "repair_retry_restart": 2, "proof": 1, "total": 11},
        "preferred": "delegated",
        "reason": "The bounded worker saves more context and repair cost than export/review adds."
      },
      {
        "id": "judgment-heavy-contract-review",
        "delegated": {"context": 3, "commands": 2, "worker": 4, "transport": 1, "review": 3, "repair_retry_restart": 2, "proof": 2, "total": 17},
        "stay_local": {"context": 6, "commands": 1, "worker": 0, "transport": 0, "review": 2, "repair_retry_restart": 0, "proof": 2, "total": 11},
        "preferred": "stay-local",
        "reason": "Handoff and duplicate context cost exceed any worker saving, so selected-current direct work is correct."
      }
    ],
    "claim_limit": "These deterministic normalized comparisons establish decision accounting, not universal provider prices; live observations append measured tokens, commands, repairs, retries, and elapsed time when available."
  }
}
