{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/repository-assurance-decision.schema.json",
  "title": "Repository Assurance Decision",
  "description": "Bounded output produced by a configured repository assurance classifier.",
  "type": "object",
  "required": ["kind", "classification_owner", "source_revision", "input_revision", "complete", "requirements"],
  "properties": {
    "kind": {"const": "agentic-workspace/repository-assurance-decision/v1", "description": "Contract discriminator."},
    "classification_owner": {"type": "string", "minLength": 1, "description": "Configured semantic owner."},
    "source_revision": {"type": "string", "minLength": 1, "description": "Classifier source revision."},
    "input_revision": {"type": "string", "minLength": 1, "description": "Current applicability input revision."},
    "complete": {"type": "boolean", "description": "Whether the producer evaluated its complete declared scope."},
    "requirements": {
      "type": "array",
      "description": "Requirements classified as active repository policy.",
      "items": {
        "type": "object",
        "required": ["id", "applicability_input"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "description": "Requirement identity."},
          "applicability_input": {"type": "object", "description": "Bounded evidence of applicability."},
          "current_work_id": {"type": "string", "description": "Optional current-work binding."},
          "required_evidence": {"type": "array", "items": {"type": "string"}, "description": "Repository-required evidence labels."},
          "blocking_claims": {"type": "array", "items": {"type": "string"}, "description": "Claims blocked by this requirement."}
        },
        "additionalProperties": true
      }
    },
    "authority_effects": {"type": "array", "maxItems": 0, "description": "Reserved field; classifiers cannot grant authority."}
  },
  "additionalProperties": false,
  "x-agentic-workspace-doc-role": "contract-reference"
}
