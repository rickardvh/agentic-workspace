{
  "kind": "agentic-workspace/security-supply-chain-policy/v1",
  "required_documents": [
    "SECURITY.md",
    "docs/security/threat-model.md"
  ],
  "required_workflows": [
    ".github/workflows/ci.yml",
    ".github/workflows/security.yml",
    ".github/workflows/release.yml"
  ],
  "required_security_jobs": [
    "baseline",
    "codeql"
  ],
  "rust_dependencies": {
    "version": "0.20.2",
    "config": "deny.toml",
    "runner": "src/tooling/check/check_rust_dependencies.py"
  },
  "trusted_shell_implementation": "src/core/src/modules/verification/native_proof.rs",
  "release_requirements": [
    "locked-dependency-resolution",
    "security-readiness-receipt",
    "sbom",
    "checksums",
    "exact-source-manifest",
    "artifact-attestation"
  ],
  "action_pin_policy": "full-commit-sha",
  "allowed_write_permissions": {
    ".github/workflows/release.yml": [
      "attestations",
      "contents",
      "id-token"
    ],
    ".github/workflows/release-from-semver-label.yml": [
      "actions",
      "contents",
      "pull-requests"
    ],
    ".github/workflows/security.yml": [
      "security-events"
    ]
  },
  "branch_enforcement_owner": "#2454"
}
