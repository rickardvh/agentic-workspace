{
  "api_version": "1.0",
  "configuration": {
    "capability_change": "invalidate-only-changed-semantic-revisions",
    "deferral": "compact-unresolved-owner-identity",
    "entry": "ordinary-start",
    "human_decision": "bounded-owner-and-revision-bound",
    "inference": "explicit-strong-current-facts-before-human-question",
    "mutation": "typed-owner-operation",
    "readiness": "current-source-owner-derived",
    "setup_workflow": false
  },
  "correction": {
    "authority": "transport-bound-not-payload-asserted",
    "deduplication": "stable-correction-id-plus-operation-receipt",
    "dispositions": [
      "already-owned",
      "memory",
      "owner-repair",
      "no-new-durable-record"
    ],
    "external_adapters": "consumers-and-transports-only",
    "ingress": "trusted-host-capability",
    "owner_consequence": "accepted-typed-owner-handoff",
    "owner_evidence": "exact-current-source-ref-and-revision"
  },
  "decision": {
    "action_order": [
      "priority:descending",
      "owner:ascending",
      "operation_id:ascending"
    ],
    "claim_policy": "blocked-overrides-allowed",
    "conflict_policy": "equal-top-priority-actions-block",
    "contribution_dimensions": [
      "facts",
      "resources",
      "procedures",
      "decisions",
      "blockers",
      "actions",
      "claims",
      "terminal"
    ],
    "statuses": [
      "direct",
      "actionable",
      "decision",
      "blocked",
      "terminal"
    ]
  },
  "identity": {
    "additive_unknown_fields": "ignored-unless-required",
    "digest": "sha256",
    "encoding": "canonical-json-utf8-nfc-ascii-escaped",
    "numbers": "safe-integers-only",
    "object_keys": "unicode-code-point-order",
    "unknown_required_semantics": "fail-closed-with-upgrade-route"
  },
  "kinds": {
    "contribution": "agentic-workspace/module-contribution/v1",
    "decision": "agentic-workspace/operating-decision/v1",
    "decision_view": "agentic-workspace/decision-view/v1",
    "invocation": "agentic-workspace/operation-invocation/v1",
    "result": "agentic-workspace/operation-result/v1"
  },
  "module": {
    "capabilities": [
      "contribution/facts",
      "contribution/resources",
      "contribution/procedures",
      "contribution/decisions",
      "operation/typed-result",
      "operation/durable-commit",
      "operation/owner-handoff",
      "state/owned-paths"
    ],
    "compatibility": "1.x",
    "optional_dimensions": [
      "facts",
      "resources",
      "procedures",
      "decisions",
      "operations"
    ],
    "ownership_policy": "exclusive-owned-domain",
    "procedure_authority": "reference-only"
  },
  "operation": {
    "commit": "owner-serialized-durable-journal",
    "currentness": "exact-input-revision",
    "effect_policy": "result-may-only-narrow-declared-effects",
    "ownership": "atomic-acquire-or-explicit-transfer",
    "replay": "same-idempotency-key-and-request",
