{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "instructions.check.process",
  "operation_id": "instructions.check",
  "adapter": {"kind": "process", "command_template": ["{agentic_workspace_cli}", "instructions", "check", "--target", ".", "--format", "json"], "cwd": "fixture_root"},
  "fixtures": [{"id": "invalid-instruction", "files": {".git/.keep": "", ".agentic-workspace/instructions/bad.md": "---\nunknown: value\n---\n# Bad\n"}}],
  "expectations": {
    "exit": {"code": 2},
    "stdout": {"format": "json", "field_assertions": [{"path": ["operation_id"], "equals": "instructions.check"}, {"path": ["status"], "equals": "invalid"}, {"path": ["exit_status"], "equals": 2}]},
    "stderr": {"allow_non_empty": false},
    "filesystem": {"allowed_write_paths": [], "required_paths": [".agentic-workspace/instructions/bad.md"], "forbidden_paths": []},
    "idempotency": {"run_twice": true},
    "safety": {"no_writes_outside_repo_root": true}
  }
}
