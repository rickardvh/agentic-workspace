{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "external-evidence.submit.process",
  "operation_id": "external-evidence.submit",
  "adapter": {
    "kind": "process",
    "command_template": ["{agentic_workspace_cli}", "external-evidence-submit", "--target", ".", "--candidate-json", "{\"kind\":\"agentic-workspace/external-evidence-candidate/v1\",\"proof_route\":\"unit\",\"evidence_class\":\"test-result\",\"proof_subject\":{}}", "--host-result-ref", "external-evidence-host-result:missing", "--format", "json"],
    "cwd": "fixture_root"
  },
  "fixtures": [{"id": "minimal-repo", "files": {".git/.keep": "", ".agentic-workspace/config.toml": "schema_version = 1\n"}}],
  "expectations": {
    "exit": {"code": 2},
    "stdout": {"format": "json", "field_assertions": [{"path": ["kind"], "equals": "agentic-workspace/external-evidence-operation-error/v1"}]},
    "stderr": {"allow_non_empty": false},
    "filesystem": {"allowed_write_paths": [], "required_paths": [".git/.keep", ".agentic-workspace/config.toml"], "forbidden_paths": [".agentic-workspace/local/proof/external-evidence-admissions"]},
    "idempotency": {"run_twice": true},
    "safety": {"no_writes_outside_repo_root": true}
  }
}
