{
  "adapter": {
    "command_template": [
      "{agentic_workspace_cli}",
      "agent-guidance",
      "supersede",
      "--target",
      ".",
      "--guidance-id",
      "guidance:missing",
      "--format",
      "json",
      "--expected-revision",
      "1",
      "--reason",
      "supersede conformance missing guidance",
      "--replacement-guidance-id",
      "guidance:replacement",
      "--expected-record-revisions-json",
      "{\"guidance:replacement\":1}"
    ],
    "cwd": "fixture_root",
    "kind": "process"
  },
  "expectations": {
    "exit": {
      "code": 0
    },
    "filesystem": {
      "allowed_write_directories": [
        ".agentic-workspace/local"
      ],
      "allowed_write_paths": [],
      "forbidden_paths": [],
      "required_paths": []
    },
    "idempotency": {
      "run_twice": false
    },
    "safety": {
      "no_writes_outside_repo_root": true
    },
    "stderr": {
      "allow_non_empty": false
    },
    "stdout": {
      "field_assertions": [
        {
          "equals": "agentic-workspace/guidance-lifecycle-result/v1",
          "path": [
            "kind"
          ]
        },
        {
          "equals": "missing-guidance",
          "path": [
            "status"
          ]
        }
      ],
      "format": "json"
    }
  },
  "fixtures": [
    {
      "files": {
        ".agentic-workspace/config.local.toml": "schema_version = 1\n\n[delegation]\ncurrent_target = \"user-local:fast-worker\"\n\n[local_memory]\ntarget_guidance_enabled = true\nuser_guidance_root = \"~/.agentic-workspace/target-guidance\"\ncorrection_events_path = \".agentic-workspace/local/correction-events.json\"\n\n[delegation_targets.fast_worker]\ntarget_id = \"user-local:fast-worker\"\ntarget_revision = \"rev-1\"\naliases = [\"fast\"]\nrevision_policy = \"preserve\"\nstrength = \"strong\"\nexecution_methods = [\"internal\"]\n",
        ".agentic-workspace/config.toml": "schema_version = 1\n[workspace]\ncli_invoke = \"agentic-workspace\"\n",
        ".git/.keep": "",
        "README.md": "# Fixture\n"
      },
      "id": "minimal-repo"
    }
  ],
  "id": "agent-guidance.supersede.process",
  "operation_id": "agent-guidance.supersede",
  "schema_version": "agentic-workspace/conformance/v1"
}
