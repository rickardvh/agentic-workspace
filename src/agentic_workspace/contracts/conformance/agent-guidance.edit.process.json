{
  "migration_status": "source-maintenance-only",
  "adapter": {
    "command_template": [
      "{agentic_workspace_cli}",
      "agent-guidance",
      "edit",
      "--target",
      ".",
      "--guidance-id",
      "guidance:missing",
      "--format",
      "json",
      "--expected-revision",
      "1",
      "--reason",
      "edit conformance missing guidance",
      "--instruction",
      "Prefer narrow edits."
    ],
    "cwd": "fixture_root",
    "kind": "process"
  },
  "expectations": {
