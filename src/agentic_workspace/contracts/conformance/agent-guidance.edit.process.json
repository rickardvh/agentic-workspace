          ]
        },
        {
          "equals": "missing-guidance",
          "path": [
            "status"
          ]
        }
      ],
      "format": "json"
    }
  },
  "fixtures": [
    {
      "files": {
        ".agentic-workspace/config.local.toml": "[delegation]\ncurrent_target = \"user-local:fast-worker\"\n\n[delegation_targets.fast_worker]\ntarget_id = \"user-local:fast-worker\"\ntarget_revision = \"rev-1\"\naliases = [\"fast\"]\ntransports = [{kind=\"internal\"}]\n",
        ".agentic-workspace/config.toml": "[workspace]\ncli_invoke = \"agentic-workspace\"\n",
        ".git/.keep": "",
        "README.md": "# Fixture\n"
      },
      "id": "minimal-repo"
    }
  ],
  "id": "agent-guidance.edit.process",
  "operation_id": "agent-guidance.edit",
  "schema_version": "agentic-workspace/conformance/v1"
