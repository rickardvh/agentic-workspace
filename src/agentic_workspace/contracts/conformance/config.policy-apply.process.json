{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "config.policy-apply.process",
  "operation_id": "config.policy-apply",
  "adapter": {
    "kind": "process",
    "command_template": [
      "{agentic_workspace_cli}", "config-policy", "--target", ".",
      "--decision-json", "{\"kind\":\"agentic-workspace/config-policy-decision/v1\",\"concern_id\":\"conformance\",\"authority\":\"human-answer\",\"scope\":\"shared\",\"setup_identity\":\"legacy-compatible\",\"changes\":{\"workspace.improvement_latitude\":\"balanced\"}}",
      "--expect-config-revision", "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "--expect-setup-identity", "legacy-compatible", "--format", "json"
    ],
    "cwd": "fixture_root"
  },
  "fixtures": [{"id": "missing-config", "files": {".git/.keep": "", "README.md": "# Fixture\n"}}],
  "expectations": {
    "exit": {"code": 0},
    "stdout": {"format": "json", "field_assertions": [
      {"path": ["kind"], "equals": "agentic-workspace/config-policy-result/v1"},
      {"path": ["outcome"], "equals": "applied"},
      {"path": ["scope"], "equals": "shared"},
      {"path": ["path"], "equals": ".agentic-workspace/config.toml"}
    ]},
    "stderr": {"allow_non_empty": false},
    "filesystem": {
      "allowed_write_paths": [".agentic-workspace/config.toml"],
      "required_paths": [".git/.keep", "README.md", ".agentic-workspace/config.toml"],
      "forbidden_paths": [".agentic-workspace/config.local.toml"]
    },
    "idempotency": {"run_twice": false},
    "safety": {"no_writes_outside_repo_root": true}
  }
}
