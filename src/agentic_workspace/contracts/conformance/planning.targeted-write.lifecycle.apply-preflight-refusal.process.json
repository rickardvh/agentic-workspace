{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "planning.targeted-write.lifecycle.apply-preflight-refusal.process",
  "operation_id": "planning.targeted-write.lifecycle",
  "adapter": {
    "kind": "process",
    "command_template": [
      "{agentic_planning_cli}",
      "targeted-write",
      "active-plan",
      "--target",
      ".",
      "--patch",
      "{\"next_action\":\"prove\"}",
      "--expect-planning-revision",
      "fixture-planning-revision",
      "--expect-owner-revision",
      "1",
      "--apply",
      "--preflight-token",
      "preflight-v1:4102444800",
      "--format",
      "json"
    ],
    "cwd": "fixture_root"
  },
  "fixtures": [
    {
      "id": "minimal-repo",
      "files": {
        ".git/.keep": "",
        "README.md": "# Fixture\n"
      }
    }
  ],
  "expectations": {
    "exit": {
      "code": 0
    },
    "stdout": {
      "format": "json",
      "field_assertions": [
        {
          "path": [
            "status"
          ],
          "equals": "caller-preflight-token-rejected"
        },
        {
          "path": [
            "preflight_admission",
            "status"
          ],
          "equals": "caller-preflight-token-rejected"
        }
      ]
    },
    "stderr": {
      "allow_non_empty": false
    },
    "filesystem": {
      "allowed_write_paths": [],
      "required_paths": [
        ".git/.keep",
        "README.md"
      ],
      "forbidden_paths": [
        ".agentic-workspace"
      ]
    },
    "idempotency": {
      "run_twice": true
    },
    "safety": {
      "no_writes_outside_repo_root": true
    }
  }
}
