{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "instructions.migrate.process",
  "operation_id": "instructions.migrate",
  "adapter": {"kind": "process", "command_template": ["{agentic_workspace_cli}", "instructions", "migrate", "--target", ".", "--from", "AGENTS.md", "--format", "json"], "cwd": "fixture_root"},
  "fixtures": [{"id": "static-instructions", "files": {".git/.keep": "", "AGENTS.md": "# Agents\n\n## Authentication\n\nKeep auth bounded.\n"}}],
  "expectations": {
    "exit": {"code": 0},
    "stdout": {"format": "json", "field_assertions": [{"path": ["operation_id"], "equals": "instructions.migrate"}, {"path": ["status"], "equals": "review-required"}, {"path": ["writes_applied"], "equals": false}]},
    "stderr": {"allow_non_empty": false},
    "filesystem": {"allowed_write_paths": [], "required_paths": ["AGENTS.md"], "forbidden_paths": [".agentic-workspace/instructions"]},
    "idempotency": {"run_twice": true},
    "safety": {"no_writes_outside_repo_root": true}
  }
}
