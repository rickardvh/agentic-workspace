{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "report.combined.process",
  "operation_id": "report.combined",
  "adapter": {
    "kind": "process",
    "command_template": [
      "{agentic_workspace_cli}",
      "report",
      "--target",
      ".",
      "--format",
      "json"
    ],
    "cwd": "fixture_root"
  },
  "fixtures": [
    {
      "id": "minimal-repo",
      "files": {
        ".git/.keep": "",
        "README.md": "# Fixture\n"
      }
    }
  ],
  "expectations": {
    "exit": {
      "code": 2
    },
    "stdout": {
      "format": "text",
      "field_assertions": [],
      "allow_empty": true
    },
    "stderr": {
      "allow_non_empty": true,
      "contains": [
        "unknown command: report"
      ]
    },
    "filesystem": {
      "allowed_write_paths": [],
      "required_paths": [
        ".git/.keep",
        "README.md"
      ],
      "forbidden_paths": [
        ".agentic-workspace"
      ]
    },
    "idempotency": {
      "run_twice": true
    },
    "safety": {
      "no_writes_outside_repo_root": true
    }
  }
}
