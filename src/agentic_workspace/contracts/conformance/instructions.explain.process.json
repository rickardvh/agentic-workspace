{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "instructions.explain.process",
  "operation_id": "instructions.explain",
  "adapter": {"kind": "process", "command_template": ["{agentic_workspace_cli}", "instructions", "explain", "--target", ".", "--changed", "src/auth/login.py", "--format", "json"], "cwd": "fixture_root"},
  "fixtures": [{"id": "scoped-repo", "files": {".git/.keep": "", ".agentic-workspace/instructions/auth.md": "---\npaths:\n  - src/auth/**\n---\n# Auth\n", ".agentic-workspace/instructions/docs.md": "---\npaths:\n  - docs/**\n---\n# Docs\n"}}],
  "expectations": {
    "exit": {"code": 0},
    "stdout": {"format": "json", "field_assertions": [{"path": ["operation_id"], "equals": "instructions.explain"}, {"path": ["applicable_count"], "equals": 1}, {"path": ["progressive_disclosure", "irrelevant_bodies_loaded"], "equals": 0}]},
    "stderr": {"allow_non_empty": false},
