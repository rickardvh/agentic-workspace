{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "instructions.create.process",
  "operation_id": "instructions.create",
  "adapter": {"kind": "process", "command_template": ["{agentic_workspace_cli}", "instructions", "new", "--target", ".", "--name", "auth", "--paths", "src/auth/**", "--format", "json"], "cwd": "fixture_root"},
  "fixtures": [{"id": "minimal-repo", "files": {".git/.keep": "", "README.md": "# Fixture\n"}}],
  "expectations": {
    "exit": {"code": 0},
    "stdout": {"format": "json", "field_assertions": [{"path": ["operation_id"], "equals": "instructions.create"}, {"path": ["status"], "equals": "created"}, {"path": ["mutation_applied"], "equals": true}]},
    "stderr": {"allow_non_empty": false},
    "filesystem": {"allowed_write_paths": [".agentic-workspace/instructions/auth.md"], "required_paths": [".agentic-workspace/instructions/auth.md"], "forbidden_paths": []},
    "idempotency": {"run_twice": false},
    "safety": {"no_writes_outside_repo_root": true}
  }
}
