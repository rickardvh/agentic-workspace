{
  "schema_version": "agentic-workspace/conformance/v1",
  "id": "instructions.list.process",
  "operation_id": "instructions.list",
  "adapter": {"kind": "process", "command_template": ["{agentic_workspace_cli}", "instructions", "list", "--target", ".", "--format", "json"], "cwd": "fixture_root"},
  "fixtures": [{"id": "minimal-repo", "files": {".git/.keep": "", "README.md": "# Fixture\n"}}],
  "expectations": {
    "exit": {"code": 0},
    "stdout": {"format": "json", "field_assertions": [{"path": ["operation_id"], "equals": "instructions.list"}, {"path": ["instruction_count"], "equals": 0}]},
    "stderr": {"allow_non_empty": false},
    "filesystem": {"allowed_write_paths": [], "required_paths": ["README.md"], "forbidden_paths": [".agentic-workspace/instructions"]},
    "idempotency": {"run_twice": true},
    "safety": {"no_writes_outside_repo_root": true}
  }
}
