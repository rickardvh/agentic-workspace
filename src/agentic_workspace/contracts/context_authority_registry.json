    "autopilot": ["planning", "assignment", "mutation-baseline", "proof", "evaluation", "autopilot-executor"],
    "closeout": ["planning", "assignment", "mutation-baseline", "proof", "evaluation", "terminal-outcome"],
    "contract-checks": ["generated-references"],
    "implement": ["system-intent", "architecture-principles", "scoped-instructions", "ownership", "planning", "memory", "assignment", "mutation-baseline", "proof", "evaluation", "skills", "target-guidance"],
