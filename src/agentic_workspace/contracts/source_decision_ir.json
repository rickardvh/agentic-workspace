      ["allowed_claims", ["sort", ["unique", ["filter", ["flat_map", ["var", "relevant"], "item", ["get", ["get", ["var", "item"], "claims"], "allowed"]], "claim", ["not", ["contains", ["var", "blocked_claims"], ["var", "claim"]]]]], ["array"]]],
      ["owner_item", ["if", ["var", "intended"], ["find", ["var", "relevant"], "item", ["eq", ["get", ["var", "item"], "owner"], ["get", ["var", "intended"], "owner"]]], null]],
