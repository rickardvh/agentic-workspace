      ["terminal_authority", ["if", ["and",
        ["var", "intended"], ["eq", ["length", ["var", "actions"]], 0], ["eq", ["length", ["var", "task_decisions"]], 0], ["not", ["var", "composition_blocker"]], ["var", "owner_item"], ["var", "found_outcome"],
