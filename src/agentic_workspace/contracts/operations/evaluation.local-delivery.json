{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "evaluation.local-delivery",
  "command_surface": {
    "command": "evaluation",
    "format_option": "format",
    "subcommand": "local-delivery"
  },
  "summary": "Record a local report compilation receipt without claiming external sink delivery.",
  "classification": "local-record-append",
  "inputs": [
    {
      "name": "target",
      "source": "cli-option",
      "required": false,
      "schema_ref": "schemas/evaluation_report_delivery_input.schema.json"
    },
    {
      "name": "evaluation_id",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "explicit",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "format",
      "source": "cli-option",
      "required": false
    }
  ],
  "output": {
    "kind": "json",
    "schema_ref": "schemas/evaluation_report_delivery_result.schema.json",
    "description": "Local report delivery receipt."
  },
  "effects": {
    "read_only": false,
    "destructive": false,
    "idempotent": true,
    "writes_repo_state": false,
    "requires_preflight_gate": false
  },
  "locality": {
    "requires_repo": true,
    "network": "forbidden",
    "outside_repo_writes": "forbidden"
  },
  "reads": [
    {
      "surface": ".agentic-workspace/evaluations.json",
      "required": true
    }
  ],
  "writes": [
    {
      "surface": ".agentic-workspace/local/evaluations/<evaluation-id>.report-deliveries.json",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve",
      "description": "Resolve the target root."
    },
    {
      "id": "record",
      "uses": "evaluation.report.local-delivery",
      "description": "Persist or deduplicate a local compilation receipt."
    },
    {
      "id": "emit_output",
      "uses": "output.emit",
      "description": "Emit local delivery receipt."
    }
  ],
  "guards": [
    "Local delivery receipts explicitly state external delivery is unattempted.",
    "Equivalent reports return the prior receipt."
  ],
  "proof": [
    "evaluation unit tests",
    "operation contract validates against operation.schema.json"
  ],
  "migration_status": "runtime-consumed"
}
