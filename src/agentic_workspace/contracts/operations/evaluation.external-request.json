{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "evaluation.external-request",
  "command_surface": {
    "command": "evaluation",
    "format_option": "format",
    "subcommand": "external-request"
  },
  "summary": "Create the current per-sink external report delivery request.",
  "classification": "read-only-report",
  "inputs": [
    {
      "name": "target",
      "source": "cli-option",
      "required": false,
      "schema_ref": "schemas/evaluation_report_delivery_input.schema.json"
    },
    {
      "name": "evaluation_id",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "explicit",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "format",
      "source": "cli-option",
      "required": false
    }
  ],
  "output": {
    "kind": "json",
    "schema_ref": "schemas/evaluation_report_delivery_result.schema.json",
    "description": "External delivery request requiring provider adapter receipts."
  },
  "effects": {
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "writes_repo_state": false,
    "requires_preflight_gate": false
  },
  "locality": {
    "requires_repo": true,
    "network": "forbidden",
    "outside_repo_writes": "forbidden"
  },
  "reads": [
    {
      "surface": ".agentic-workspace/evaluations.json",
      "required": true
    }
  ],
  "writes": [],
  "steps": [
    {
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve",
      "description": "Resolve the target root."
    },
    {
      "id": "request",
      "uses": "evaluation.report.external-request",
      "description": "Resolve current report authority and produce stable per-sink idempotency keys."
    },
    {
      "id": "emit_output",
      "uses": "output.emit",
      "description": "Emit delivery request."
    }
  ],
  "guards": [
    "Requests are stale if current report authority changes.",
    "Requests do not prove any transport result."
  ],
  "proof": [
    "evaluation unit tests",
    "operation contract validates against operation.schema.json"
  ],
  "migration_status": "runtime-consumed"
}
