{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "evaluation.external-adapter-receipt",
  "command_surface": {
    "command": "evaluation",
    "format_option": "format",
    "subcommand": "external-adapter-receipt"
  },
  "summary": "Record a producer-owned external adapter attempt/result receipt for later delivery admission.",
  "classification": "local-record-append",
  "inputs": [
    {
      "name": "target",
      "source": "cli-option",
      "required": false,
      "schema_ref": "schemas/evaluation_report_delivery_input.schema.json"
    },
    {
      "name": "delivery_id",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "sink_id",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "producer",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "attempt_revision",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "receipt_revision",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "capability_revision",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "capability_status",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "status_owner",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "status",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "detail",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "supersedes",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "format",
      "source": "cli-option",
      "required": false
    }
  ],
  "output": {
    "kind": "json",
    "schema_ref": "schemas/evaluation_report_delivery_result.schema.json",
    "description": "Indexed producer-owned adapter receipt."
  },
  "effects": {
    "read_only": false,
    "destructive": false,
    "idempotent": true,
    "writes_repo_state": false,
    "requires_preflight_gate": false
  },
  "locality": {
    "requires_repo": true,
    "network": "forbidden",
    "outside_repo_writes": "forbidden"
  },
  "reads": [
    {
      "surface": ".agentic-workspace/local/evaluations/external-adapter-receipts/index.json",
      "required": false
    }
  ],
  "writes": [
    {
      "surface": ".agentic-workspace/local/evaluations/external-adapter-receipts/<receipt-id>.json",
      "required": true
    },
    {
      "surface": ".agentic-workspace/local/evaluations/external-adapter-receipts/index.json",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve",
      "description": "Resolve the target root."
    },
    {
      "id": "record",
      "uses": "evaluation.delivery.adapter-receipt.record",
      "description": "Validate and index provider-owned capability/result receipt."
    },
    {
      "id": "emit_output",
      "uses": "output.emit",
      "description": "Emit adapter receipt record."
    }
  ],
  "guards": [
    "Receipt status, producer, attempt, and capability revisions are required.",
    "Superseded receipts are demoted in the producer-owned index.",
    "Transport success is later admitted only by referencing an indexed receipt."
  ],
  "proof": [
    "evaluation unit tests",
    "operation contract validates against operation.schema.json"
  ],
  "migration_status": "runtime-consumed"
}
