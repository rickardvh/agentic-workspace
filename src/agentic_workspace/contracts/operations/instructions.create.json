{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "instructions.create",
  "command_surface": {"command": "instructions", "subcommand": "new", "format_option": "format"},
  "summary": "Create one scoped Markdown instruction without overwriting an existing file.",
  "classification": "lifecycle-mutation",
  "inputs": [
    {"name": "target", "source": "cli-option", "required": false},
    {"name": "format", "source": "cli-option", "required": false},
    {"name": "name", "source": "cli-option", "required": true},
    {"name": "paths", "source": "cli-option", "required": false}
  ],
  "output": {"kind": "text-or-json", "schema_ref": "schemas/scoped_instruction_operation_result.schema.json"},
  "effects": {"read_only": false, "destructive": false, "idempotent": false, "writes_repo_state": true, "requires_preflight_gate": false},
  "locality": {"requires_repo": false, "network": "forbidden", "outside_repo_writes": "forbidden"},
  "reads": [{"surface": ".agentic-workspace/instructions/<name>.md", "required": false}],
  "writes": [{"surface": ".agentic-workspace/instructions/<name>.md", "required": true, "when": "the destination does not exist", "description": "one new scoped instruction scaffold"}],
  "steps": [
    {"id": "resolve_root", "uses": "workspace.target-root.resolve", "description": "Resolve the target root."},
    {"id": "execute_instruction_operation", "uses": "instructions.execute", "description": "Create through the no-overwrite scoped instruction semantic owner."},
    {"id": "emit_output", "uses": "output.emit", "description": "Emit the instruction result."}
  ],
  "ir_plan": {"status": "complete", "steps": [
    {"id": "resolve_root", "uses": "workspace.target-root.resolve", "description": "resolve_root", "outputs": ["target_root"]},
    {"id": "execute_instruction_operation", "uses": "instructions.execute", "description": "execute_instruction_operation", "outputs": ["result"]},
    {"id": "emit_output", "uses": "output.emit", "description": "emit_output", "outputs": ["emitted"]}
  ]},
  "guards": ["Reject invalid names and repository-relative path patterns.", "Never overwrite an existing instruction file."],
  "proof": ["instructions.create.process", "generated Python and TypeScript operation clients preserve the no-overwrite boundary"],
  "migration_status": "runtime-consumed"
}
