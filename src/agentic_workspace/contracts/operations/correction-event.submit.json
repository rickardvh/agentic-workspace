  "intent": "Preserve signed host correction observations, then normalize and disposition them through the existing correction-event lifecycle boundary.",
  "ir_plan": {
    "status": "complete",
    "steps": [
      {
        "description": "resolve_root",
        "id": "resolve_root",
        "outputs": [
          "target_root"
        ],
        "uses": "workspace.target-root.resolve"
      },
      {
        "description": "apply_correction_event",
        "id": "apply_correction_event",
        "outputs": [
          "result"
        ],
        "uses": "correction.event.apply"
      },
      {
        "description": "emit_output",
        "id": "emit_output",
        "outputs": [
          "emitted"
        ],
        "uses": "output.emit"
      }
    ]
  },
  "locality": {
    "network": "forbidden",
    "outside_repo_writes": "forbidden",
    "requires_repo": true
  },
  "migration_status": "runtime-consumed",
  "output": {
    "kind": "text-or-json",
    "schema_ref": "schemas/correction_event_result.schema.json"
  },
  "proof": [
    "correction-event generated operation tests cover trusted submit, low-authority preservation, query, and compact retention",
    "cross-target conformance fails closed when native runtimes cannot resolve a trusted host observation",
    "operation contract validates against operation.schema.json"
  ],
  "reads": [
    {
      "description": "bounded local correction-event store",
      "required": false,
      "surface": ".agentic-workspace/local/correction-events.json"
    },
    {
      "description": "existing signed trusted-authority observation custody",
      "required": false,
      "surface": ".agentic-workspace/local/trusted-authority-events"
    }
  ],
  "schema_version": "agentic-workspace/operation/v1",
  "steps": [
    {
      "description": "Resolve target root.",
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve"
    },
    {
      "description": "Apply correction-event lifecycle operation.",
      "id": "apply_correction_event",
      "uses": "correction.event.apply"
    },
    {
      "description": "Emit result.",
      "id": "emit_output",
      "uses": "output.emit"
    }
  ],
  "summary": "Preserve or normalize a correction through the public local operation boundary.",
  "writes": [
    {
      "description": "bounded local correction-event store and receipts",
      "required": true,
      "surface": ".agentic-workspace/local/correction-events.json",
      "when": "mutation operation stores or compacts admitted/low-authority events"
    },
    {
      "description": "signed host observation and trusted custody index",
      "required": false,
      "surface": ".agentic-workspace/local/trusted-authority-events",
      "when": "trusted_host_event_json passes producer signature and custody admission"
    }
  ]
}
