{
  "classification": "local-record-append",
  "command_surface": {
    "command": "correction-event",
    "format_option": "format",
    "subcommand": "submit"
  },
  "effects": {
    "destructive": false,
    "idempotent": true,
    "read_only": false,
    "requires_preflight_gate": false,
    "writes_repo_state": false
  },
  "guards": [
    "Generated operation boundary resolves target subjects from workspace config by default.",
    "Caller-supplied producer labels cannot upgrade authority; trusted authority must resolve from trusted_authority_receipt_ref.",
    "Signed trusted_host_event_json is verified against pinned producer custody, channel, workspace, lifecycle, and signature before import.",
    "Incomplete trusted observations remain in existing trusted-authority custody until host_event_ref is normalized; downstream route decisions are separate.",
    "A canonical-owner route requires both canonical_owner_ref and canonical_owner_evidence_ref and resolves disposition without creating duplicate Memory or guidance policy.",
    "Agent self-observation is preserved as low-authority non-routing evidence.",
    "Correction storage is local-only and has no checked-in repo meaning."
  ],
  "id": "correction-event.submit",
  "inputs": [
    {
      "name": "target",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "format",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "event_json",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "trusted_host_event_json",
      "required": false,
      "source": "cli-option",
      "description": "Canonical JSON agentic-workspace/trusted-authority-host-event/v1 envelope. host_admission is RS256 over the v1 payload {kind, algorithm, key_id, event_ref, event_digest, verdict_digest, audience}; the pinned key issuer/channel, verdict workspace binding, expiry, nonce, event identity, and custody must agree."
    },
    {
      "name": "host_event_ref",
      "required": false,
      "source": "cli-option",
      "description": "Opaque trusted-authority-event:<id> returned by prior signed observation custody; it conveys no authority unless the stored signature and import custody remain valid."
    },
    {
      "name": "trusted_authority_receipt_ref",
