{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "external-evidence.query",
  "command_surface": {"command": "external-evidence-query", "format_option": "format"},
  "summary": "Query and revalidate one external proof candidate and opaque host result.",
  "classification": "read-only-report",
  "inputs": [
    {"name": "target", "source": "cli-option", "required": false, "schema_ref": "schemas/external_evidence_operation_input.schema.json"},
    {"name": "candidate_json", "source": "cli-option", "required": true},
    {"name": "host_result_ref", "source": "cli-option", "required": true},
    {"name": "format", "source": "cli-option", "required": false}
  ],
  "output": {"kind": "json", "schema_ref": "schemas/external_evidence_operation_result.schema.json"},
  "effects": {"read_only": true, "destructive": false, "idempotent": true, "writes_repo_state": false, "requires_preflight_gate": false},
  "locality": {"requires_repo": true, "network": "forbidden", "outside_repo_writes": "forbidden"},
  "reads": [
    {"surface": ".agentic-workspace/local/proof/external-evidence-host-results/inbox/<result-id>.json", "required": true},
    {"surface": ".agentic-workspace/verification/manifest.toml", "required": true},
    {"surface": "stored proof-subject source inputs", "required": true}
  ],
  "writes": [],
  "steps": [
    {"id": "resolve_root", "uses": "workspace.target-root.resolve", "description": "Resolve the target repository."},
    {"id": "query_evidence", "uses": "assurance.external-evidence.apply", "description": "Re-resolve signed custody, repository authority, and current proof-subject status."},
    {"id": "emit_output", "uses": "output.emit", "description": "Emit the current structured admission result."}
  ],
  "guards": ["Query is stateless and re-verifies the signed host result, candidate binding, current repository policy, and current dependency inputs."],
  "proof": ["external evidence public-operation tests", "independent generated-client fixture", "operation contract validation"],
  "migration_status": "runtime-consumed"
}
