{
  "classification": "lifecycle-mutation",
  "command_surface": {
    "command": "agent-guidance",
    "format_option": "format",
    "subcommand": "promote"
  },
  "effects": {
    "destructive": false,
    "idempotent": true,
    "read_only": false,
    "requires_preflight_gate": false,
    "writes_repo_state": false
  },
  "guards": [
    "Generated operation boundary resolves promotion authority from correction-event and guidance receipt stores by default.",
    "Lifecycle transitions require expected revisions before mutation.",
    "Mutation receipts preserve provenance and affected record ids.",
    "Guidance storage is local-only and has no checked-in repo meaning."
  ],
  "id": "agent-guidance.promote",
  "inputs": [
    {
      "name": "format",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "target",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "guidance_id",
      "required": true,
      "source": "cli-option"
    },
    {
      "name": "expected_revision",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "expected_record_revisions_json",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "reason",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "instruction",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "replacement_guidance_id",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "merge_guidance_ids",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "split_instructions",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "task_class",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "scope_class",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "explicit_remember",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "dry_run",
      "required": false,
      "source": "cli-option"
    }
  ],
  "intent": "Expose the public generated agent-guidance lifecycle boundary for promotion and reversible local guidance mutation.",
  "ir_plan": {
    "status": "complete",
    "steps": [
      {
        "description": "resolve_root",
        "id": "resolve_root",
        "outputs": [
          "target_root"
        ],
        "uses": "workspace.target-root.resolve"
      },
      {
        "description": "apply_guidance_lifecycle",
        "id": "apply_guidance_lifecycle",
        "outputs": [
          "result"
        ],
        "uses": "guidance.lifecycle.apply"
      },
      {
        "description": "emit_output",
        "id": "emit_output",
        "outputs": [
          "emitted"
        ],
        "uses": "output.emit"
      }
    ]
  },
  "locality": {
    "network": "forbidden",
    "outside_repo_writes": "forbidden",
    "requires_repo": true
  },
  "migration_status": "runtime-consumed",
  "output": {
    "kind": "text-or-json",
    "schema_ref": "schemas/guidance_lifecycle_result.schema.json"
  },
  "proof": [
    "agent-guidance lifecycle generated operation tests cover wrapper availability and transition fail-closed behavior",
    "operation contract validates against operation.schema.json"
  ],
  "reads": [
    {
      "description": "bounded local guidance lifecycle store",
      "required": false,
      "surface": ".agentic-workspace/local/guidance-lifecycle.json"
    }
  ],
  "schema_version": "agentic-workspace/operation/v1",
  "steps": [
    {
      "description": "Resolve target root.",
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve"
    },
    {
      "description": "Apply guidance lifecycle operation.",
      "id": "apply_guidance_lifecycle",
      "uses": "guidance.lifecycle.apply"
    },
    {
      "description": "Emit result.",
      "id": "emit_output",
      "uses": "output.emit"
    }
  ],
  "summary": "Promote one authorised guidance candidate into its lifecycle store.",
  "writes": [
    {
      "description": "bounded local guidance lifecycle store and receipts",
      "required": false,
      "surface": ".agentic-workspace/local/guidance-lifecycle.json",
      "when": "authorized lifecycle mutation applies"
    }
  ]
}
