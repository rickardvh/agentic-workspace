{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "instructions.list",
  "command_surface": {"command": "instructions", "subcommand": "list", "format_option": "format"},
  "summary": "List scoped Markdown instructions without loading irrelevant bodies.",
  "classification": "read-only-report",
  "inputs": [
    {"name": "target", "source": "cli-option", "required": false},
    {"name": "format", "source": "cli-option", "required": false}
  ],
  "output": {"kind": "text-or-json", "schema_ref": "schemas/scoped_instruction_operation_result.schema.json"},
  "effects": {"read_only": true, "destructive": false, "idempotent": true, "writes_repo_state": false, "requires_preflight_gate": false},
  "locality": {"requires_repo": false, "network": "forbidden", "outside_repo_writes": "forbidden"},
  "reads": [{"surface": ".agentic-workspace/instructions/*.md", "required": false}],
  "writes": [],
  "steps": [
    {"id": "resolve_root", "uses": "workspace.target-root.resolve", "description": "Resolve the target root."},
    {"id": "execute_instruction_operation", "uses": "instructions.execute", "description": "List instructions through the scoped instruction semantic owner."},
    {"id": "emit_output", "uses": "output.emit", "description": "Emit the instruction result."}
  ],
  "ir_plan": {"status": "complete", "steps": [
    {"id": "resolve_root", "uses": "workspace.target-root.resolve", "description": "resolve_root", "outputs": ["target_root"]},
    {"id": "execute_instruction_operation", "uses": "instructions.execute", "description": "execute_instruction_operation", "outputs": ["result"]},
    {"id": "emit_output", "uses": "output.emit", "description": "emit_output", "outputs": ["emitted"]}
  ]},
  "guards": ["Do not load irrelevant Markdown bodies.", "Do not mutate instruction files while listing."],
  "proof": ["instructions.list.process", "generated Python and TypeScript operation clients consume the same result schema"],
  "migration_status": "runtime-consumed"
}
