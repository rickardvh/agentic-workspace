{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "evaluation.external-delivery",
  "command_surface": {
    "command": "evaluation",
    "format_option": "format",
    "subcommand": "external-delivery"
  },
  "summary": "Admit one external report delivery result from a current producer-owned adapter receipt.",
  "classification": "local-record-append",
  "inputs": [
    {
      "name": "target",
      "source": "cli-option",
      "required": false,
      "schema_ref": "schemas/evaluation_report_delivery_input.schema.json"
    },
    {
      "name": "evaluation_id",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "adapter_receipt_ref",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "explicit",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "format",
      "source": "cli-option",
      "required": false
    }
  ],
  "output": {
    "kind": "json",
    "schema_ref": "schemas/evaluation_report_delivery_result.schema.json",
    "description": "Admitted delivery receipt or retryable rejection."
  },
  "effects": {
    "read_only": false,
    "destructive": false,
    "idempotent": true,
    "writes_repo_state": false,
    "requires_preflight_gate": false
  },
  "locality": {
    "requires_repo": true,
    "network": "forbidden",
    "outside_repo_writes": "forbidden"
  },
  "reads": [
    {
      "surface": ".agentic-workspace/evaluations.json",
      "required": true
    },
    {
      "surface": ".agentic-workspace/local/evaluations/external-adapter-receipts/index.json",
      "required": true
    }
  ],
  "writes": [
    {
      "surface": ".agentic-workspace/local/evaluations/<evaluation-id>.external-deliveries.json",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve",
      "description": "Resolve the target root."
    },
    {
      "id": "admit",
      "uses": "evaluation.delivery.external-admit",
      "description": "Recompute the current request and admit only the referenced indexed producer receipt."
    },
    {
      "id": "emit_output",
      "uses": "output.emit",
      "description": "Emit delivery admission result."
    }
  ],
  "guards": [
    "Current request is recomputed at admission time.",
    "Arbitrary inline dictionaries and success flags are ignored.",
    "Superseded, revoked, stale, unindexed, or wrong-sink receipts fail closed."
  ],
  "proof": [
    "evaluation unit tests",
    "operation contract validates against operation.schema.json"
  ],
  "migration_status": "runtime-consumed"
}
