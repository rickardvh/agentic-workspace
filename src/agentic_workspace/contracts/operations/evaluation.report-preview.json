{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "evaluation.report-preview",
  "command_surface": {
    "command": "evaluation",
    "format_option": "format",
    "subcommand": "report-preview"
  },
  "summary": "Compile current evaluation report authority without claiming external delivery.",
  "classification": "read-only-report",
  "inputs": [
    {
      "name": "target",
      "source": "cli-option",
      "required": false,
      "schema_ref": "schemas/evaluation_report_delivery_input.schema.json"
    },
    {
      "name": "evaluation_id",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "explicit",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "format",
      "source": "cli-option",
      "required": false
    }
  ],
  "output": {
    "kind": "json",
    "schema_ref": "schemas/evaluation_report_delivery_result.schema.json",
    "description": "Evaluation report-authority payload."
  },
  "effects": {
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "writes_repo_state": false,
    "requires_preflight_gate": false
  },
  "locality": {
    "requires_repo": true,
    "network": "forbidden",
    "outside_repo_writes": "forbidden"
  },
  "reads": [
    {
      "surface": ".agentic-workspace/evaluations.json",
      "required": true
    },
    {
      "surface": ".agentic-workspace/local/evaluations/<evaluation-id>.jsonl",
      "required": false
    }
  ],
  "writes": [],
  "steps": [
    {
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve",
      "description": "Resolve the target root."
    },
    {
      "id": "compile",
      "uses": "evaluation.report.preview",
      "description": "Resolve current definition and admitted summary state and compile report authority."
    },
    {
      "id": "emit_output",
      "uses": "output.emit",
      "description": "Emit report preview."
    }
  ],
  "guards": [
    "Preview status is derived from current admitted evaluation state.",
    "Preview never claims local or external delivery."
  ],
  "proof": [
    "evaluation unit tests",
    "operation contract validates against operation.schema.json"
  ],
  "migration_status": "runtime-consumed"
}
