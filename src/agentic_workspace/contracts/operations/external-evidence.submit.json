{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "external-evidence.submit",
  "command_surface": {"command": "external-evidence-submit", "format_option": "format"},
  "summary": "Submit externally produced proof through an opaque package-trusted host result.",
  "classification": "local-record-append",
  "inputs": [
    {"name": "target", "source": "cli-option", "required": false, "schema_ref": "schemas/external_evidence_operation_input.schema.json"},
    {"name": "candidate_json", "source": "cli-option", "required": true},
    {"name": "host_result_ref", "source": "cli-option", "required": true},
    {"name": "format", "source": "cli-option", "required": false}
  ],
  "output": {"kind": "json", "schema_ref": "schemas/external_evidence_operation_result.schema.json"},
  "effects": {"read_only": true, "destructive": false, "idempotent": true, "writes_repo_state": false, "requires_preflight_gate": false},
  "locality": {"requires_repo": true, "network": "forbidden", "outside_repo_writes": "forbidden"},
  "reads": [
    {"surface": ".agentic-workspace/local/proof/external-evidence-host-results/inbox/<result-id>.json", "required": true},
    {"surface": ".agentic-workspace/verification/manifest.toml", "required": true},
    {"surface": "candidate proof-subject source inputs", "required": true}
  ],
  "writes": [],
  "steps": [
    {"id": "resolve_root", "uses": "workspace.target-root.resolve", "description": "Resolve the target repository."},
    {"id": "submit_evidence", "uses": "assurance.external-evidence.apply", "description": "Verify host custody, resolve repository authority, classify the current proof subject, and return one compact admitted result."},
    {"id": "emit_output", "uses": "output.emit", "description": "Emit the structured admission result."}
  ],
  "guards": [
    "Callers provide an opaque host_result_ref and cannot provide authenticated producer custody.",
    "The package-trusted signature binds producer, issuer, result contract, result, proof route, evidence class, and proof-subject digest.",
    "Verification evidence_authorities are loaded by the operation from repository policy rather than submitted by the transport.",
    "Current source inputs are re-read before proof-subject classification; the operation creates no parallel evidence ledger."
  ],
  "proof": ["external evidence public-operation tests", "independent generated-client fixture", "operation contract validation"],
  "migration_status": "runtime-consumed"
}
