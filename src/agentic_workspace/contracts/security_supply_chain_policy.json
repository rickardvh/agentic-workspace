{
  "kind": "agentic-workspace/security-supply-chain-policy/v1",
  "required_documents": [
    "SECURITY.md",
    "docs/security/threat-model.md"
  ],
  "required_workflows": [
    ".github/workflows/ci.yml",
    ".github/workflows/security.yml",
    ".github/workflows/release.yml"
  ],
  "required_security_jobs": [
    "dependency-review",
    "codeql",
    "secret-scan"
  ],
  "trusted_shell_sources": [
    "checked-repository-proof-route",
    "explicit-user-executor-command"
  ],
  "trusted_shell_implementation": "src/agentic_workspace/trusted_execution.py",
  "release_requirements": [
    "locked-dependency-resolution",
    "security-readiness-receipt",
    "sbom",
    "checksums",
    "exact-source-manifest",
    "artifact-attestation"
  ],
  "action_pin_policy": "full-commit-sha",
  "branch_enforcement_owner": "#2454"
}
