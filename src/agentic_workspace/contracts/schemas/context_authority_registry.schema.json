{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/context-authority-registry.schema.json",
  "title": "Agentic Workspace Context Authority Registry",
  "description": "Versioned source of truth for ordinary operating-decision authority surfaces and consumer requirements.",
  "type": "object",
  "required": ["kind", "schema_version", "rule", "currentness_contract", "ordinary_decision_consumers", "consumer_requirements", "surfaces"],
  "properties": {
    "kind": {
      "const": "agentic-workspace/context-authority-registry/v1",
      "description": "Schema discriminator for the operating-decision authority registry."
    },
    "schema_version": {"type": "integer", "minimum": 1, "description": "Monotonic registry schema version."},
    "rule": {"type": "string", "minLength": 1, "description": "Contract rule explaining how runtime must consume the registry."},
    "currentness_contract": {
      "type": "object",
      "description": "Shared taxonomy and derivation rules for owner-bound currentness, coverage, repair, and decision dispositions.",
      "required": [
        "kind",
        "rule",
        "dispositions",
        "coverage_effects",
        "consumer_effects",
        "representative_owner_classes",
        "read_only_refresh_operations",
        "revision_guarded_repair_operations",
        "safe_repair_rule",
        "decision_rule",
        "quiet_rule"
      ],
      "properties": {
        "kind": {"const": "agentic-workspace/context-currentness-contract/v1", "description": "Schema discriminator for the currentness contract."},
        "rule": {"type": "string", "minLength": 1, "description": "Owner responsibility rule applied when obligations are projected."},
        "dispositions": {
          "type": "array",
          "description": "Closed ordered vocabulary for state and action dispositions.",
          "prefixItems": [
            {"const": "current"},
            {"const": "derivably-stale"},
            {"const": "refreshable-derived"},
            {"const": "safely-repairable"},
            {"const": "missing-relevant-coverage"},
            {"const": "decision-required"},
            {"const": "outside-responsibility"}
          ],
          "items": false
        },
        "coverage_effects": {
          "type": "array",
          "description": "Bounded operating-decision effects that make missing coverage material to AW.",
          "items": {"enum": ["action", "authority", "proof", "claim", "procedure", "continuation"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "consumer_effects": {
          "type": "object",
          "description": "Operating effects owned by each ordinary decision consumer.",
          "additionalProperties": {
            "type": "array",
            "description": "Material operating effects for this consumer.",
            "items": {"enum": ["action", "authority", "proof", "claim", "procedure", "continuation"]},
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "representative_owner_classes": {
          "type": "object",
          "description": "Audit map showing how major AW owner classes derive their obligations from registered surfaces.",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "description": "One representative owner class and its registry-backed disposition.",
            "required": ["surfaces", "disposition"],
            "properties": {
              "surfaces": {
                "type": "array",
                "description": "Registered surfaces that supply this owner class's currentness and coverage semantics.",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1,
                "uniqueItems": true
              },
              "disposition": {"type": "string", "minLength": 1, "description": "Owner-specific authority and lifecycle posture."}
            },
            "additionalProperties": false
          }
        },
        "read_only_refresh_operations": {
          "type": "array",
          "description": "Dispatch-contract-backed operations that recompute derived authority without repository mutation.",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "revision_guarded_repair_operations": {
          "type": "array",
          "description": "Dispatch-contract-backed mutations that accept both registry and source revision guards.",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "safe_repair_rule": {"type": "string", "minLength": 1, "description": "Admission rule for executable repair dispositions."},
        "decision_rule": {"type": "string", "minLength": 1, "description": "Conservative boundary for semantic or consequential ambiguity."},
        "quiet_rule": {"type": "string", "minLength": 1, "description": "Proportionality rule preventing irrelevant surfaces from creating maintenance pressure."}
      },
      "additionalProperties": false
    },
    "ordinary_decision_consumers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true,
      "description": "Ordinary AW consumers that must have measured authority coverage."
    },
    "consumer_requirements": {
      "type": "object",
      "description": "Required authority surfaces for each ordinary decision consumer.",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true,
        "description": "Authority surfaces required by this consumer."
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "description": "Declared authority surfaces available to ordinary operating decisions.",
      "items": {
        "type": "object",
        "required": [
          "surface",
          "owner",
          "authority_class",
          "consumers",
          "activation",
          "editable_by",
          "stale_when",
          "proof_route",
          "disposition",
          "revision_fields"
        ],
        "properties": {
          "surface": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "authority_class": {
            "type": "string",
            "enum": ["canonical", "derived", "advisory", "historical/evidence", "local-only", "temporary", "generated", "hard-gate"]
          },
          "consumers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "activation": {"type": "string", "minLength": 1},
          "editable_by": {"type": "string", "minLength": 1},
          "stale_when": {"type": "string", "minLength": 1},
          "proof_route": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "minLength": 1},
          "decision_dimension": {
            "type": "string",
            "minLength": 1,
            "description": "Optional canonical operating-decision dimension changed by material guidance from this source."
          },
          "revision_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "source_owner_contract": {
            "type": "object",
            "required": ["owner_module", "owner_result_kind", "repair_operation_id"],
            "properties": {
              "owner_module": {"type": "string", "minLength": 1},
              "owner_result_kind": {"type": "string", "minLength": 1},
              "repair_operation_id": {"type": "string", "minLength": 1},
              "reconciliation_operation_id": {"type": "string", "minLength": 1},
              "reconciliation_mode": {
                "type": "string",
                "enum": ["read-only-refresh", "state-mutation", "unavailable"]
              },
              "activation_terms": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "baseline_for": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-agentic-workspace-doc-role": "contract-reference"
}
