{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/evidence-authority.schema.json",
  "title": "Evidence Authority",
  "description": "Repository proof-policy declaration authorizing one producer for a bounded external proof route.",
  "type": "object",
  "required": ["kind", "id", "producer_id", "proof_route", "evidence_class", "result_contract", "allowed_results"],
  "properties": {
    "kind": {"const": "agentic-workspace/evidence-authority/v1", "description": "Contract discriminator."},
    "id": {"type": "string", "minLength": 1, "description": "Repository-owned authority identity."},
    "producer_id": {"type": "string", "minLength": 1, "description": "Authorized evidence producer; transport is deliberately separate."},
    "issuer_id": {"type": "string", "minLength": 1, "description": "Optional host-authenticated issuer required for this producer."},
    "proof_route": {"type": "string", "minLength": 1, "description": "Proof route within which authority applies."},
    "evidence_class": {"type": "string", "minLength": 1, "description": "Authorized class of evidence."},
    "result_contract": {"type": "string", "minLength": 1, "description": "Producer result contract."},
    "allowed_results": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true, "description": "Results the repository policy understands."},
    "application_id": {"type": "string", "description": "Optional assurance-application binding."}
  },
  "additionalProperties": false,
  "x-agentic-workspace-doc-role": "contract-reference"
}
