{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/assurance-applicability/v1",
  "title": "Current assurance applicability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements",
    "changed_paths",
    "planning_facts",
    "route_fact",
    "source_revision",
    "task_identity",
    "current_work"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "force": {
            "enum": [
              "informational",
              "recommended",
              "required-before-closeout",
              "blocking"
            ]
          },
          "applies_to_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to_task_markers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to_semantic_routes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to_planning_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to_proof_profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to_risk_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to_invariant_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocking_claims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planning_facts": {
      "type": "object",
      "properties": {
        "refs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "proof_profiles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "risk_refs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "invariant_refs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "legacy_refs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "route_fact": {
      "type": [
        "object",
        "null"
      ]
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "task_identity": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "current_work": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "judgment": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "source_revision",
        "task_identity",
        "current_work",
        "decisions"
      ],
      "properties": {
        "source_revision": {
          "type": "string"
        },
        "task_identity": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "current_work": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "decisions": {
          "$ref": "#/$defs/decisions"
        }
      }
    }
  },
  "$defs": {
    "decisions": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {
        "enum": [
          "applicable",
          "not-applicable",
          "unresolved"
        ]
      }
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisions"
      ],
      "properties": {
        "decisions": {
          "$ref": "#/$defs/decisions"
        }
      }
    }
  }
}
