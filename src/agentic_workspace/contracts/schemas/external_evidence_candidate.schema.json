{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/external-evidence-candidate.schema.json",
  "title": "External Evidence Candidate",
  "description": "Provider-neutral candidate reference that remains untrusted until repository proof policy admits it.",
  "type": "object",
  "required": ["kind", "producer_id", "proof_route", "evidence_class", "result_contract", "result", "evidence_ref", "proof_subject"],
  "properties": {
    "kind": {"const": "agentic-workspace/external-evidence-candidate/v1", "description": "Contract discriminator."},
    "producer_id": {"type": "string", "minLength": 1, "description": "Identity of the evidence producer."},
    "transport_id": {"type": "string", "description": "Transport identity, which grants no producer authority."},
    "proof_route": {"type": "string", "minLength": 1, "description": "Claimed proof route."},
    "evidence_class": {"type": "string", "minLength": 1, "description": "Claimed evidence class."},
    "result_contract": {"type": "string", "minLength": 1, "description": "Contract under which the result was issued."},
    "result": {"type": "string", "minLength": 1, "description": "Producer result, distinct from admission status."},
    "evidence_ref": {"type": "string", "minLength": 1, "description": "Bounded external reference; logs are not embedded."},
    "proof_subject": {"type": "object", "description": "Existing dependency-scoped proof subject."}
  },
  "additionalProperties": false,
  "x-agentic-workspace-doc-role": "contract-reference"
}
