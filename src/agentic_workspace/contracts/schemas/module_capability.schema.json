{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/module-capability.schema.json",
  "title": "Agentic Workspace Public Module Capability Contract",
  "description": "Small capability-first contract for peer modules. Workspace owns resolve, act, and reconcile; modules declare only domain identity, ownership, source-owned facts, relevance, optional capabilities, and result semantics.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "description",
    "compatibility",
    "ownership",
    "relevance",
    "capabilities",
    "result_semantics"
  ],
  "properties": {
    "schema_version": {
      "const": "agentic-workspace/module-capability/v2",
      "description": "Contract field for module.schema_version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Contract field for module.name."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Contract field for module.description."
    },
    "compatibility": {
      "type": "object",
      "required": [
        "reader_epoch",
        "required_capabilities"
      ],
      "properties": {
        "reader_epoch": {
          "type": "integer",
          "minimum": 1,
          "description": "Contract field for module.compatibility.reader_epoch."
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.compatibility.required_capabilities."
        }
      },
      "additionalProperties": true,
      "description": "Contract field for module.compatibility."
    },
    "ownership": {
      "type": "object",
      "required": [
        "roots",
        "effect_classes",
        "authority_exclusions"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.ownership.roots."
        },
        "effect_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.ownership.effect_classes."
        },
        "authority_exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.ownership.authority_exclusions."
        }
      },
      "additionalProperties": true,
      "description": "Contract field for module.ownership."
    },
    "relevance": {
      "type": "object",
      "required": [
        "task_terms",
        "path_prefixes"
      ],
      "properties": {
        "task_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.relevance.task_terms."
        },
        "path_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.relevance.path_prefixes."
        },
        "always": {
          "type": "boolean",
          "default": false,
          "description": "Contract field for module.relevance.always."
        }
      },
      "additionalProperties": true,
      "description": "Contract field for module.relevance."
    },
    "facts": {
      "type": "array",
      "default": [],
      "description": "Optional typed source-owned facts contributed to the existing instruction and operating-decision path. Facts remain owned and refreshed by the module's public contract provider; after an operation reports facts, fresh discovery must expose the matching snapshot. This is not a central fact store.",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "resources": {
          "$ref": "#/$defs/capability_list",
          "description": "Contract field for module.capabilities.resources."
        },
        "skills": {
          "$ref": "#/$defs/capability_list",
          "description": "Contract field for module.capabilities.skills."
        },
        "operations": {
          "$ref": "#/$defs/capability_list",
          "description": "Contract field for module.capabilities.operations."
        },
        "setup_concerns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setup_concern"
          },
          "description": "Bounded semantic setup concerns applicable only while this module is explicitly enabled. Declarations are read-only contributions; effects remain owned by their route."
        }
      },
      "additionalProperties": true,
      "description": "Contract field for module.capabilities."
    },
    "result_semantics": {
      "type": "object",
      "required": [
        "schema_version",
        "guaranteed_fields",
        "effect_fields",
        "warning_fields"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "description": "Contract field for module.result_semantics.schema_version."
        },
        "guaranteed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.result_semantics.guaranteed_fields."
        },
        "effect_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.result_semantics.effect_fields."
        },
        "warning_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Contract field for module.result_semantics.warning_fields."
        }
      },
      "additionalProperties": true,
      "description": "Contract field for module.result_semantics."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Contract field for module.dependencies."
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Contract field for module.conflicts."
    },
    "selection_rank": {
      "type": "integer",
      "description": "Contract field for module.selection_rank."
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["facts"],
        "properties": {
          "facts": {"minItems": 1}
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": {
              "required_capabilities": {
                "contains": {"const": "module-facts-v1"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "required": ["setup_concerns"],
            "properties": {
              "setup_concerns": {"minItems": 1}
            }
          }
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": {
              "required_capabilities": {
                "contains": {"const": "module-setup-concerns-v1"}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "setup_concern": {
      "type": "object",
      "required": ["id", "semantic_revision", "source_revision", "status", "materiality", "owner", "applicability", "route"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Stable semantic concern id within the owning module."},
        "semantic_revision": {"type": "string", "minLength": 1, "description": "Changes only when the concern meaning or decision validity changes."},
        "source_revision": {"type": "string", "minLength": 1, "description": "Current module-owned source revision used to derive status."},
        "status": {"enum": ["satisfied", "inference-ready", "human-decision-required", "not-applicable"]},
        "materiality": {"enum": ["recommended", "action-required"]},
        "owner": {"type": "string", "minLength": 1, "description": "Canonical owner for any effect or decision."},
        "applicability": {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "module-enabled"}},
          "additionalProperties": false
        },
        "route": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": {"enum": ["detail", "skill", "operation", "human-decision"]},
            "id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "question": {"type": "string", "minLength": 1},
        "inference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": ["id", "type", "value", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Stable fact identity."},
        "type": {"enum": ["boolean", "string", "string-set", "identity"], "description": "Value type accepted by the bounded instruction predicate operators."},
        "value": {"description": "Current source-owned fact value."},
        "subject": {"type": "string", "description": "Optional source-owned subject identity."},
        "source": {
          "type": "object",
          "required": ["owner", "revision", "current"],
          "properties": {
            "owner": {"type": "string", "minLength": 1, "description": "Owning module identity."},
            "revision": {"type": "string", "minLength": 1, "description": "Revision or freshness identity for this value."},
            "current": {"type": "boolean", "description": "Whether the revision is current."}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "boolean"}}},
          "then": {"properties": {"value": {"type": "boolean"}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["string", "identity"]}}},
          "then": {"properties": {"value": {"type": "string"}}}
        },
        {
          "if": {"properties": {"type": {"const": "string-set"}}},
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "capability_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Contract field for module.capability_list[].id."
          },
          "description": {
            "type": "string",
            "description": "Contract field for module.capability_list[].description."
          },
          "ref": {
            "type": "string",
            "description": "Contract field for module.capability_list[].ref."
          },
          "input_schema": {
            "type": "string",
            "description": "Contract field for module.capability_list[].input_schema."
          },
          "result_schema": {
            "type": "string",
            "description": "Contract field for module.capability_list[].result_schema."
          },
          "read_only": {
            "type": "boolean",
            "description": "Contract field for module.capability_list[].read_only."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "x-agentic-workspace-doc-role": "contract-reference"
}
