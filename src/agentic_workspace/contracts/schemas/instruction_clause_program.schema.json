{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/instruction-clause-program.schema.json",
  "title": "Instruction Clause Program",
  "description": "Internal source-owned facts and bounded clauses compiled into the existing operating decision.",
  "type": "object",
  "required": ["kind", "facts", "clauses", "capabilities"],
  "properties": {
    "kind": {"const": "agentic-workspace/instruction-program/v1", "description": "Schema discriminator for one internal instruction program."},
    "facts": {
      "type": "array",
      "description": "Typed source-owned projections evaluated by clauses without creating a central fact store.",
      "items": {
        "type": "object",
        "required": ["id", "type", "value", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["boolean", "string", "string-set", "identity"]},
          "value": {},
          "subject": {"type": "string"},
          "source": {"$ref": "#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "clauses": {
      "type": "array",
      "description": "Source-bound bounded condition-to-effect relationships.",
      "items": {
        "type": "object",
        "required": ["id", "source", "when", "effects", "authority"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/source"},
          "when": {"$ref": "#/$defs/predicate"},
          "effects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effect"}},
          "authority": {
            "type": "object",
            "required": ["effects", "target_patterns"],
            "properties": {
              "effects": {"type": "array", "items": {"enum": ["surface", "prefer", "require", "restrict"]}, "uniqueItems": true},
              "target_patterns": {"type": "array", "items": {"type": "string", "pattern": "^(surface|skill|operation|evidence|human|action|effect|claim):"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Current source-owned satisfiers and affordances referenced by clauses.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "current", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["surface", "skill", "operation", "evidence", "human-decision"]},
          "current": {"type": "boolean"},
          "evidence_state": {"type": "string"},
          "detail_route": {"type": "string"},
          "source": {"$ref": "#/$defs/source"}
        },
        "additionalProperties": false
      }
    },
    "source_diagnostics": {
      "type": "array",
      "description": "Typed adapter diagnostics emitted when a source owner cannot provide an unambiguous bounded clause input.",
      "items": {
        "type": "object",
        "required": ["code", "ref", "owner", "repair"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "repair": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["owner", "revision", "current"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "current": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["fact", "operator"],
          "properties": {
            "fact": {"type": "string", "minLength": 1},
            "operator": {"enum": ["present", "is", "one_of", "intersects", "matches", "current"]},
            "value": {},
            "values": {"type": "array"}
          },
          "additionalProperties": false
        },
        {"type": "object", "required": ["all"], "properties": {"all": {"type": "array", "items": {"$ref": "#/$defs/predicate"}}}, "additionalProperties": false},
        {"type": "object", "required": ["any"], "properties": {"any": {"type": "array", "items": {"$ref": "#/$defs/predicate"}}}, "additionalProperties": false},
        {"type": "object", "required": ["none"], "properties": {"none": {"type": "array", "items": {"$ref": "#/$defs/predicate"}}}, "additionalProperties": false}
      ]
    },
    "effect": {
      "type": "object",
      "required": ["kind", "target"],
      "properties": {
        "kind": {"enum": ["surface", "prefer", "require", "restrict"]},
        "target": {"type": "string", "pattern": "^(surface|skill|operation|evidence|human|action|effect|claim):"},
        "satisfier": {"type": "string"},
        "reason": {"type": "string"},
        "requirement": {
          "type": "object",
          "description": "Compact source/evidence metadata for a named repo requirement; effect authority remains in this clause.",
          "properties": {
            "id": {"type": "string"},
            "requirement_class": {"enum": ["invariant", "current-evidence", "guideline"]},
            "source_intent_ref": {"type": "string"},
            "source_intent_revision": {"type": "string"},
            "source_intent_current": {"type": "boolean"},
            "evidence_owner": {"type": "string"},
            "evidence_state": {"type": "string"},
            "detail_route": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-agentic-workspace-doc-role": "contract-reference"
}
