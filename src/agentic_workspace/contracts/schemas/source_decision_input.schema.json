{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workspace.dev/schemas/source-decision-input/v1",
  "title": "Source decision input",
  "description": "Language-neutral input envelope for the shared operating-decision core.",
  "x-agentic-workspace-doc-role": "contract-reference",
  "type": "object",
  "properties": {
    "decision_context": {"$ref": "#/$defs/decision_context", "description": "Optional independently admitted material decision context; absent or unrelated input remains quiet."},
    "intent": {
      "description": "Explicit task intent supplied by the acting agent or human rather than inferred by the reducer.",
      "type": "object",
      "properties": {
        "current_work": {
          "description": "Current task identity used only to reject a stale semantic-route selection.",
          "$ref": "#/$defs/current_work"
        },
        "semantic_route_source": {
          "description": "Current repo-owned semantic-route identities and their source revision.",
          "$ref": "#/$defs/semantic_route_source"
        },
        "semantic_task_routes": {
          "description": "Acting-agent selection bound to the current task and route-source revisions.",
          "$ref": "#/$defs/semantic_route_selection"
        },
        "public_request": {
          "description": "One typed source-owner intention selected by an agent or human and bound to current task and capability revisions.",
          "$ref": "#/$defs/public_request"
        },
        "outcome": {
          "description": "Exact outcome authority required before the task may be terminal.",
          "type": "object",
          "properties": {
        "required_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "Outcome-owner-declared claims that must be currently allowed before completion; absence of their owner or evidence does not waive them."},
            "id": {"type": "string", "minLength": 1, "description": "Stable intended outcome identity."},
            "owner": {"type": "string", "minLength": 1, "description": "Owner authorized to establish the intended outcome."},
            "claim": {"type": "string", "minLength": 1, "description": "Claim that must be allowed for terminal status."}
          },
          "required": ["id", "owner", "claim"]
        }
      },
      "dependentRequired": {
        "semantic_route_source": ["current_work", "semantic_task_routes"],
        "semantic_task_routes": ["current_work", "semantic_route_source"],
        "public_request": ["current_work"]
      },
      "additionalProperties": false
    },
    "capability_contract": {
      "description": "Current declarative ownership and constructibility authority for any authority-bearing contribution or public request.",
      "$ref": "#/$defs/capability_contract"
    },
    "contributions": {
      "description": "Current source-owned contributions composed by the shared reducer.",
      "type": "array",
      "items": {"$ref": "#/$defs/contribution"}
    }
  },
  "required": ["contributions"],
  "additionalProperties": false,
  "$defs": {
    "decision_reference": {
      "type": "object",
      "description": "Source reference; neither strings nor hashes grant custody or authority.",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Independent source owner."
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Exact source or material dependency identity."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Revision currently expected from this source owner."
        }
      },
      "required": [
        "owner",
        "reference",
        "revision"
      ],
      "additionalProperties": false
    },
    "decision_actor": {
      "type": "object",
      "description": "Semantic actor. AW context is evidence, not an actor.",
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "human"
          ],
          "description": "Semantic actor kind, independently admitted by the host."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable actor identity."
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "decision_authority": {
      "type": "object",
      "description": "Deciding authority, distinct from authorship and contribution.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/decision_actor",
          "description": "The actor supplying the decisive authority."
        },
        "basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_reference",
            "description": "Admitted authority basis."
          },
          "description": "Delegation/domain/human evidence establishing deciding authority.",
          "minItems": 1
        }
      },
      "required": [
        "actor",
        "basis"
      ],
      "additionalProperties": false
    },
    "decision_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(path|owner|contract|source|operation):.+$"
      },
      "description": "Exact affected identities. No glob or prose matching.",
      "minItems": 1
    },
    "decision_supersedes": {
      "type": "object",
      "description": "Explicit scoped replacement by a distinct identity.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Prior stable decision identity."
        },
        "material_revision": {
          "type": "string",
          "minLength": 1,
          "description": "Exact prior semantic revision."
        },
        "scope": {
          "$ref": "#/$defs/decision_scope",
          "description": "Superseded subset of both decisions scopes."
        }
      },
      "required": [
        "id",
        "material_revision",
        "scope"
      ],
      "additionalProperties": false
    },
    "material_decision": {
      "type": "object",
      "description": "Semantic record. Normalization does not admit its authorship, authority or source custody.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable source-assigned decision identity; not a workspace/view digest."
        },
        "source": {
          "$ref": "#/$defs/decision_reference",
          "description": "Current canonical source admission, separate from material revision."
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "description": "Compact semantic choice authored by agents/humans."
        },
        "consequence": {
          "type": "string",
          "minLength": 1,
          "description": "Compact consequence for later applicable work; grants no executable authority."
        },
        "rationale_reference": {
          "type": "string",
          "minLength": 1,
          "description": "Source reference for rationale, meaningful alternatives and history."
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_actor",
            "description": "Semantic author."
          },
          "description": "Actors that developed the choice.",
          "minItems": 1
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_actor",
            "description": "Contributor."
          },
          "description": "Other semantic contributors."
        },
        "authority": {
          "$ref": "#/$defs/decision_authority",
          "description": "Exact decisive authority/provenance."
        },
        "scope": {
          "$ref": "#/$defs/decision_scope",
          "description": "Governed scope."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_reference",
            "description": "Dependency."
          },
          "description": "Material evidence/source dependencies."
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_reference",
            "description": "Material context."
          },
          "description": "Context that informed the choice, including AW owner evidence without AW authorship."
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_supersedes",
            "description": "Prior decision replacement."
          },
          "description": "Explicit prior decisions replaced within scope."
        },
        "material_revision": {
          "type": [
            "string",
            "null"
          ],
          "description": "Rust-derived material revision; when supplied it must match the record."
        }
      },
      "required": [
        "id",
        "source",
        "decision",
        "consequence",
        "rationale_reference",
        "authors",
        "authority",
        "scope"
      ],
      "additionalProperties": false
    },
    "decision_admission": {
      "type": "object",
      "description": "Independent trusted-host admission, not a client declaration. The host must establish provenance and source custody before supplying this binding.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Admitted stable identity."
        },
        "material_revision": {
          "type": "string",
          "minLength": 1,
          "description": "Exact admitted semantic revision, including deciding authority and provenance."
        },
        "source": {
          "$ref": "#/$defs/decision_reference",
          "description": "Exact currently admitted canonical source."
        }
      },
      "required": [
        "id",
        "material_revision",
        "source"
      ],
      "additionalProperties": false
    },
    "decision_context": {
      "type": "object",
      "description": "Bounded material decisions supplied to the existing compiler. No storage, discovery, execution permissions or authority creation.",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material_decision",
            "description": "Selected record."
          },
          "description": "Bounded owner-selected records with complete applicable supersession closure.",
          "maxItems": 64
        },
        "admissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_admission",
            "description": "Independent admission."
          },
          "description": "Source/authority-owner admissions."
        },
        "current_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_reference",
            "description": "Current dependency."
          },
          "description": "Current independently observed material revisions."
        },
        "applicable_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(path|owner|contract|source|operation):.+$"
          },
          "description": "Current exact scope selected by host/agent; no semantic inference."
        }
      },
      "required": [
        "records",
        "admissions",
        "current_dependencies",
        "applicable_scope"
      ],
      "additionalProperties": false
    },
    "current_work": {
      "type": "object",
      "properties": {
        "kind": {"const": "current-work", "description": "Identity namespace for current task binding."},
        "id": {"type": "string", "minLength": 1, "description": "Opaque current task or Planning identity."}
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "route_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)+$"
    },
    "semantic_route_source": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Current digest of the repo-owned route declarations."
        },
        "routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/route_id"},
          "uniqueItems": true,
          "description": "Currently declared leaf route identities."
        }
      },
      "required": ["revision", "routes"],
      "additionalProperties": false
    },
    "semantic_route_selection": {
      "type": "object",
      "properties": {
        "posture": {
          "enum": ["selected", "none", "unresolved"],
          "description": "Explicit acting-agent classification posture."
        },
        "routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/route_id"},
          "uniqueItems": true,
          "description": "Agent-selected declared leaf routes; empty for none or unresolved."
        },
        "task_identity": {
          "$ref": "#/$defs/current_work",
          "description": "Task identity current when the acting agent made the selection."
        },
        "source_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Route declaration revision current when the selection was made."
        },
        "provenance": {"const": "agent-selected", "description": "Selection authority, never a lexical classifier."},
        "authority_effect": {
          "const": "applicability-only",
          "description": "Ceiling preventing a route from granting effects or claims."
        }
      },
      "required": ["posture", "routes", "task_identity", "source_revision", "provenance", "authority_effect"],
      "allOf": [
        {
          "if": {"properties": {"posture": {"const": "selected"}}},
          "then": {"properties": {"routes": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"posture": {"enum": ["none", "unresolved"]}}},
          "then": {"properties": {"routes": {"maxItems": 0}}}
        }
      ],
      "additionalProperties": false
    },
    "input_schema": {
      "description": "Self-contained Draft 2020-12 JSON Schema; Rust validates the schema and its instances with external retrieval disabled.",
      "type": "object",
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "description": "JSON Schema dialect."
        }
      },
      "required": [
        "$schema"
      ]
    },
    "request_shape": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Public owner intention discriminator, independent of operation identity."
        },
        "input_schema": {
          "$ref": "#/$defs/input_schema",
          "description": "JSON Schema for intention arguments."
        },
        "result_kind": {
          "type": "string",
          "minLength": 1,
          "description": "Owner response discriminator."
        }
      },
      "required": [
        "kind",
        "input_schema",
        "result_kind"
      ],
      "additionalProperties": false
    },
    "operation_capability": {
      "type": "object",
      "properties": {
        "semantic_revision": {"type": "string", "minLength": 1, "description": "Admitted operation implementation/recovery semantic revision; independent of package and source view revisions."},
        "reads": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "Complete admitted material read-domain footprint for independence proof. Absent means unknown; an empty array explicitly means no reads. Writes use the declared effect ceiling."},
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Globally unique operation identity owned by one capability owner."
        },
        "input_schema": {
          "$ref": "#/$defs/input_schema",
          "description": "JSON Schema for exact owner-derived operation arguments."
        },
        "result_kind": {
          "type": "string",
          "minLength": 1,
          "description": "Typed operation result discriminator."
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Maximum effects this operation may advertise, all owned by the same owner."
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Claims for which the same owner has exclusive authority."
        }
      },
      "required": [
        "semantic_revision",
        "id",
        "input_schema",
        "result_kind"
      ],
      "additionalProperties": false
    },
    "capability_owner": {
      "type": "object",
      "properties": {
        "owner": {"type": "string", "minLength": 1, "description": "Stable capability owner identity."},
        "revision": {"type": "string", "minLength": 1, "description": "Current semantic revision of this owner declaration."},
        "domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "Exclusive domains managed by this owner."},
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "minLength": 1, "description": "Stable effect identity."},
              "domain": {"type": "string", "minLength": 1, "description": "One domain declared by the same owner."}
            },
            "required": ["id", "domain"],
            "additionalProperties": false
          }
        },
        "requests": {"type": "array", "items": {"$ref": "#/$defs/request_shape"}, "description": "Public owner intentions, independently declared from operations."},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation_capability"}, "description": "Public operations this owner can construct and answer."}
      },
      "required": ["owner", "revision"],
      "additionalProperties": false
    },
    "capability_contract": {
      "type": "object",
      "properties": {
        "kind": {"const": "agentic-workspace/capability-contract/v1", "description": "Capability contract discriminator."},
        "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Current source revision to which public requests bind."},
        "owners": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability_owner"}, "description": "Current admitted capability owners."},
        "restriction_authorities": {
          "type": "array",
          "description": "Trusted admission of exact restriction scopes, independent of claim grants and effect ownership. Task is an explicit scope, not a wildcard. No contribution or implementation descriptor can self-grant these rights.",
          "items": {
            "type": "object",
            "properties": {
              "owner": {"type": "string", "minLength": 1},
              "affects": {"$ref": "#/$defs/affects"}
            },
            "required": ["owner", "affects"],
            "additionalProperties": false
          }
        },
        "claim_authorities": {
          "type": "array",
          "description": "Exclusive claim-to-owner assignments admitted independently of source contributions.",
          "items": {
            "type": "object",
            "properties": {
              "claim": {"type": "string", "minLength": 1, "description": "Grantable claim identity."},
              "owner": {"type": "string", "minLength": 1, "description": "Sole capability owner authorized to grant the claim."}
            },
            "required": ["claim", "owner"],
            "additionalProperties": false
          }
        }
      },
      "required": ["kind", "revision", "owners"],
      "additionalProperties": false
    },
    "public_request": {
      "type": "object",
      "properties": {
        "kind": {"const": "agentic-workspace/public-request/v1", "description": "Public request envelope discriminator."},
        "id": {"type": "string", "minLength": 1, "description": "Caller correlation identity for one bounded request."},
        "owner": {"type": "string", "minLength": 1, "description": "Capability owner asked to interpret the request."},
        "owner_revision": {"type": "string", "minLength": 1, "description": "Capability-owner semantic revision current when selected."},
        "source_revision": {"type": "string", "minLength": 1, "description": "Owner contribution revision current when selected."},
        "request_kind": {"type": "string", "minLength": 1, "description": "Declared typed request discriminator."},
        "capability_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Capability contract revision current when selected."},
        "task_identity": {"$ref": "#/$defs/current_work", "description": "Current work identity when the acting agent or human selected the request."},
        "arguments": {"type": "object", "description": "Arguments admitted by the declared bounded request shape."}
      },
      "required": ["kind", "id", "owner", "owner_revision", "source_revision", "request_kind", "capability_revision", "task_identity", "arguments"],
      "additionalProperties": false
    },
    "affects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(task|(action|decision|effect|claim|outcome):.+)$"}
    },
    "action": {
      "type": "object",
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "dependency_revision": {"type": "string", "minLength": 1, "description": "Owner-derived revision of material action dependencies, excluding unrelated source changes."},
        "effect_generation": {"type": "string", "description": "Owner-authorized repeat boundary; absent means the initial logical effect, never ambient revision churn."},
        "arguments": {"type": "object"},
        "effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authority": {"type": "string", "minLength": 1}
      },
      "required": ["operation_id", "dependency_revision"],
      "not": {"required": ["priority"]}
    },
    "blocker": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "affects": {"$ref": "#/$defs/affects"}
      },
      "required": ["code", "message", "affects"]
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "response_request": {"type": "object", "properties": {"request_kind": {"type": "string", "minLength": 1}, "arguments": {"type": "object", "not": {"required": ["answer"]}}}, "required": ["request_kind", "arguments"], "additionalProperties": false, "description": "Owner request kind and fixed arguments; only the answer slot is human/domain supplied."},
        "choices": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}},
            "required": ["id", "label"]
          }
        },
        "affects": {"$ref": "#/$defs/affects"}
      },
      "required": ["id", "question", "response_request", "affects"]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "evidence_revision": {"type": "string", "minLength": 1},
        "residual_work": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["id", "status", "claim", "evidence_revision"]
    },
    "contribution": {
      "type": "object",
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "relevant": {"type": "boolean"},
        "settled": {"type": "boolean"},
        "facts": {"type": "object"},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "claims": {
          "type": "object",
          "properties": {
            "allowed": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "blocked": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "outcome": {"$ref": "#/$defs/outcome"},
        "request_response": {
          "type": "object",
          "properties": {
            "request_identity": {"type": "string", "minLength": 1, "description": "Complete normalized identity returned by the shared request preparation boundary."},
            "consequence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Exact current owner consequences answering this request only; empty for a settled response."},
            "status": {"enum": ["action", "decision", "blocked", "settled"], "description": "Kind of exact owner response present in this contribution."}
          },
          "required": ["request_identity", "consequence_ids", "status"],
          "additionalProperties": false
        }
      },
      "required": ["owner", "revision"],
      "not": {"required": ["terminal"]}
    }
  }
}
