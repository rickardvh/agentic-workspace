{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workspace.dev/schemas/source-decision-input/v1",
  "title": "Source decision input",
  "description": "Language-neutral input envelope for the shared operating-decision core.",
  "x-agentic-workspace-doc-role": "contract-reference",
  "type": "object",
  "properties": {
    "intent": {
      "description": "Explicit task intent supplied by the acting agent or human rather than inferred by the reducer.",
      "type": "object",
      "properties": {
        "current_work": {
          "description": "Current task identity used only to reject a stale semantic-route selection.",
          "$ref": "#/$defs/current_work"
        },
        "semantic_route_source": {
          "description": "Current repo-owned semantic-route identities and their source revision.",
          "$ref": "#/$defs/semantic_route_source"
        },
        "semantic_task_routes": {
          "description": "Acting-agent selection bound to the current task and route-source revisions.",
          "$ref": "#/$defs/semantic_route_selection"
        },
        "outcome": {
          "description": "Exact outcome authority required before the task may be terminal.",
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1, "description": "Stable intended outcome identity."},
            "owner": {"type": "string", "minLength": 1, "description": "Owner authorized to establish the intended outcome."},
            "claim": {"type": "string", "minLength": 1, "description": "Claim that must be allowed for terminal status."}
          },
          "required": ["id", "owner", "claim"]
        }
      },
      "dependentRequired": {
        "current_work": ["semantic_route_source", "semantic_task_routes"],
        "semantic_route_source": ["current_work", "semantic_task_routes"],
        "semantic_task_routes": ["current_work", "semantic_route_source"]
      }
    },
    "contributions": {
      "description": "Current source-owned contributions composed by the shared reducer.",
      "type": "array",
      "items": {"$ref": "#/$defs/contribution"}
    }
  },
  "required": ["contributions"],
  "additionalProperties": false,
  "$defs": {
    "current_work": {
      "type": "object",
      "properties": {
        "kind": {"const": "current-work", "description": "Identity namespace for current task binding."},
        "id": {"type": "string", "minLength": 1, "description": "Opaque current task or Planning identity."}
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "route_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)+$"
    },
    "semantic_route_source": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Current digest of the repo-owned route declarations."
        },
        "routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/route_id"},
          "uniqueItems": true,
          "description": "Currently declared leaf route identities."
        }
      },
      "required": ["revision", "routes"],
      "additionalProperties": false
    },
    "semantic_route_selection": {
      "type": "object",
      "properties": {
        "posture": {
          "enum": ["selected", "none", "unresolved"],
          "description": "Explicit acting-agent classification posture."
        },
        "routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/route_id"},
          "uniqueItems": true,
          "description": "Agent-selected declared leaf routes; empty for none or unresolved."
        },
        "task_identity": {
          "$ref": "#/$defs/current_work",
          "description": "Task identity current when the acting agent made the selection."
        },
        "source_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Route declaration revision current when the selection was made."
        },
        "provenance": {"const": "agent-selected", "description": "Selection authority, never a lexical classifier."},
        "authority_effect": {
          "const": "applicability-only",
          "description": "Ceiling preventing a route from granting effects or claims."
        }
      },
      "required": ["posture", "routes", "task_identity", "source_revision", "provenance", "authority_effect"],
      "allOf": [
        {
          "if": {"properties": {"posture": {"const": "selected"}}},
          "then": {"properties": {"routes": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"posture": {"enum": ["none", "unresolved"]}}},
          "then": {"properties": {"routes": {"maxItems": 0}}}
        }
      ],
      "additionalProperties": false
    },
    "affects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(task|(action|decision|effect|claim|outcome):.+)$"}
    },
    "action": {
      "type": "object",
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"},
        "effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authority": {"type": "string", "minLength": 1}
      },
      "required": ["operation_id"],
      "not": {"required": ["priority"]}
    },
    "blocker": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "affects": {"$ref": "#/$defs/affects"}
      },
      "required": ["code", "message", "affects"]
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "response_operation_id": {"type": "string", "minLength": 1},
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}},
            "required": ["id", "label"]
          }
        },
        "affects": {"$ref": "#/$defs/affects"}
      },
      "required": ["id", "question", "response_operation_id", "choices", "affects"]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "evidence_revision": {"type": "string", "minLength": 1},
        "residual_work": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["id", "status", "claim", "evidence_revision"]
    },
    "contribution": {
      "type": "object",
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "relevant": {"type": "boolean"},
        "settled": {"type": "boolean"},
        "facts": {"type": "object"},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "claims": {
          "type": "object",
          "properties": {
            "allowed": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "blocked": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "outcome": {"$ref": "#/$defs/outcome"}
      },
      "required": ["owner", "revision"],
      "not": {"required": ["terminal"]}
    }
  }
}
