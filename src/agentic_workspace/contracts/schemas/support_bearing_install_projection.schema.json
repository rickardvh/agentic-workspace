{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/support-bearing-install-projection.schema.json",
  "title": "Support-Bearing Install Projection",
  "description": "Checked-in projection of the latest immutable release-owned installation receipt.",
  "type": "object",
  "required": ["kind", "version", "status", "published_at", "release_url", "source_commit", "receipt", "artifact", "install_command"],
  "properties": {
    "kind": {"const": "agentic-workspace/support-bearing-install-projection/v1", "description": "Contract discriminator."},
    "version": {"type": "string", "description": "Projected release version."},
    "status": {"const": "passed", "description": "Release receipt admission status."},
    "published_at": {"type": "string", "format": "date-time", "description": "Release publication time."},
    "release_url": {"type": "string", "format": "uri", "description": "Immutable versioned release page."},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "Dereferenced release tag commit."},
    "receipt": {
      "type": "object",
      "description": "Immutable release-owned readiness receipt identity.",
      "required": ["kind", "url", "sha256"],
      "properties": {
        "kind": {"const": "agentic-workspace/distribution-install-readiness/v1", "description": "Receipt kind."},
        "url": {"type": "string", "format": "uri", "description": "Immutable receipt asset URL."},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Receipt content digest."}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "description": "Root wheel selected by the receipt.",
      "required": ["name", "url", "sha256"],
      "properties": {
        "name": {"type": "string", "description": "Artifact filename."},
        "url": {"type": "string", "format": "uri", "description": "Immutable release artifact URL."},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Artifact digest."}
      },
      "additionalProperties": false
    },
    "install_command": {"type": "string", "minLength": 1, "description": "Exact human-copyable command projected from the release receipt."}
  },
  "additionalProperties": false,
  "x-agentic-workspace-doc-role": "contract-reference"
}
