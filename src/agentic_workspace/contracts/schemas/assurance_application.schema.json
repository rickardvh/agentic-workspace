{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-workspace/assurance-application.schema.json",
  "title": "Assurance Application Identity",
  "description": "Source-bound identity for why one repository assurance requirement applies to current work.",
  "type": "object",
  "required": ["kind", "status", "application_id", "fingerprint", "requirement_id", "classification_owner", "source_revision", "applicability_input", "current_work_id"],
  "properties": {
    "kind": {"const": "agentic-workspace/assurance-application/v1", "description": "Contract discriminator."},
    "status": {"enum": ["current", "unverifiable"], "description": "Whether all required identity inputs are present."},
    "application_id": {"type": "string", "description": "Stable application identity, empty when unverifiable."},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Digest of classification-relevant inputs."},
    "requirement_id": {"type": "string", "description": "Repository assurance requirement identity."},
    "classification_owner": {"type": "string", "description": "Configured owner of classification semantics."},
    "source_revision": {"type": "string", "description": "Revision of the classification source."},
    "applicability_input": {"type": "object", "description": "Bounded input used to decide applicability."},
    "current_work_id": {"type": "string", "description": "Optional identity of current work."},
    "missing_identity_fields": {"type": "array", "items": {"type": "string"}, "description": "Required identity inputs that were absent."},
    "rule": {"type": "string", "description": "Identity and authority boundary."}
  },
  "additionalProperties": false,
  "x-agentic-workspace-doc-role": "contract-reference"
}
