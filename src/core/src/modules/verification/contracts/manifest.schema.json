{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "execution_prerequisites": {
      "type": "object",
      "description": "Declared deterministic requirements of an isolated selected command. Native Verification checks these before selected-command launch; no script dependency inference.",
      "properties": {
        "source_inputs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "image_executables": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 4096 } },
        "git_subject": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 2, "maxLength": 4096 },
            "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          },
          "required": ["path", "revision"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "execution": {
      "type": "object",
      "properties": {
        "kind": { "const": "docker-readonly-source-v1" },
        "image": { "type": "string", "maxLength": 1024, "pattern": "^(sha256:|[^ ]+@sha256:)[a-f0-9]{64}$" },
        "inputs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "scratch_paths": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "environment": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128 }, "additionalProperties": { "type": "string", "maxLength": 2048 } }
      },
      "required": ["kind", "inputs"],
      "additionalProperties": false
    },
    "schema_version": {
      "const": "agentic-workspace/verification-manifest/v1"
    },
    "protocols": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "input_refs", "stop_conditions"],
            "properties": {
              "question": { "type": "string", "minLength": 1, "maxLength": 8192 },
              "input_refs": { "type": "array", "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
              "stop_conditions": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } }
            },
            "description": "Bounded read-only investigation of this protocol's selected native receipt; analysis never satisfies proof or independent approval."
          },
          "execution_prerequisites": { "$ref": "#/$defs/execution_prerequisites" },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "review_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "ownerless_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "applies_to_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "applies_to_task_markers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "assurance_requirement_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "proof_profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "scenario_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "expected_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "authority_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "stale_when": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "review_aids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "independent_required": {
            "type": "boolean"
          },
          "manual_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "protocol_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "automation_hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "manual_boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "expected_observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "pass_evidence_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "fail_evidence_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "proof_routes": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "execution_prerequisites": { "$ref": "#/$defs/execution_prerequisites" },
          "protocol_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "scenario_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "assurance_requirement_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "review_aids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "proof_lane_hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          }
        },
        "additionalProperties": false
      }
    },
    "assurance": {
      "$ref": "assurance.schema.json"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version"
  ]
}
