{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workspace.dev/schemas/planning_reconciliation.schema.json",
  "title": "Planning same-owner reconciliation",
  "x-agentic-workspace-doc-role": "contract-reference",
  "type": "object",
  "description": "Trusted Planning host boundary. Source custody is admitted outside this payload; shape, names and hashes cannot establish it.",
  "properties": {
    "source_requests": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "source_decision_input.schema.json#/$defs/public_request"
      },
      "description": "Explicit current source-owner request dependencies retained for exact invocation revalidation; not proof or mutation authority."
    },
    "target": {
      "type": "string",
      "description": "Host-selected target root."
    },
    "relevant": {
      "type": "boolean",
      "description": "Agent/human-owned Planning applicability; false does not read sources or create files."
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/evidence",
          "description": "Exact source authority supplied by the trusted source owner."
        },
        {
          "type": "null"
        }
      ],
      "description": "Established Planning source custody, not caller-created authority."
    },
    "irrelevant_history": {
      "type": "boolean",
      "description": "Agent/human judgement that explicit drift_log fields have no continuation value."
    },
    "intent": {
      "type": "object",
      "description": "Current work and requested outcome context."
    },
    "capability_contract": {
      "type": [
        "object",
        "null"
      ],
      "description": "Independently admitted capability/effect contract."
    },
    "custody": {
      "anyOf": [
        {
          "$ref": "#/$defs/custody",
          "description": "Independently retained result custody."
        },
        {
          "type": "null"
        }
      ],
      "description": "Current reconciliation custody supplied by the responsible host."
    },
    "invocation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Exact returned action for effect admission."
    },
    "selection_transition": {
      "anyOf": [
        {
          "$ref": "#/$defs/selection_transition",
          "description": "Native selector currentness; no material identity or caller authority."
        },
        {
          "type": "null",
          "description": "No selector switch is proposed."
        }
      ],
      "description": "Optional exact selector transition supplied by the native Planning owner."
    }
  },
  "required": [
    "target",
    "relevant"
  ],
  "additionalProperties": false,
  "$defs": {
    "retained_reconciliation": {
      "type": "object",
      "description": "Bounded producer custody retained by the already admitted current owner selection; not caller authority or Planning semantics.",
      "properties": {
        "kind": {
          "const": "agentic-planning/reconciliation-custody/v1",
          "description": "Versioned retained producer custody."
        },
        "current_work": {
          "type": "object",
          "description": "Exact work identity whose continuation was admitted."
        },
        "source": {
          "$ref": "#/$defs/evidence",
          "description": "Exact selected semantic owner source at production."
        },
        "invocation": {
          "type": "object",
          "description": "Exact owner-derived admitted operation."
        },
        "custody": {
          "$ref": "#/$defs/custody",
          "description": "Producer-returned attempt and optional committed references."
        }
      },
      "required": [
        "kind",
        "current_work",
        "source",
        "invocation",
        "custody"
      ],
      "additionalProperties": false
    },
    "update_recovery_request": {
      "type": "object",
      "description": "Exact update recovery; requires continue-selected; no material edit.",
      "properties": {
        "owner_ref": {
          "type": "string",
          "description": "Exact current native-created owner reference."
        },
        "pending_revision": {
          "type": "string",
          "description": "Owner-returned update revision."
        }
      },
      "required": [
        "owner_ref",
        "pending_revision"
      ],
      "additionalProperties": false
    },
    "continuation_request": {
      "type": "object",
      "description": "Relation/posture only; no effect authority.",
      "properties": {
        "owner_ref": {
          "type": "string",
          "description": "Destination; native custody required."
        },
        "answer": {
          "type": "string",
          "enum": [
            "continue-selected",
            "independent",
            "unrelated-direct",
            "authorize-selector-transfer"
          ],
          "description": "Relation; unrelated-direct means independent/direct."
        },
        "transfer_revision": {
          "type": "string",
          "minLength": 1,
          "description": "Exact owner-bound transfer revision."
        },
        "task_posture": {
          "type": "string",
          "enum": [
            "direct",
            "planned"
          ],
          "description": "Independent posture; absent means undecided."
        }
      },
      "required": [
        "answer"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "answer": {
                "const": "authorize-selector-transfer"
              }
            },
            "required": [
              "answer"
            ]
          },
          "then": {
            "required": [
              "transfer_revision"
            ],
            "not": {
              "required": [
                "owner_ref"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "transfer_revision"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "task_posture"
            ]
          },
          "then": {
            "properties": {
              "answer": {
                "const": "independent"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "path",
        "owner",
        "revision"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical workspace target to which this custody reference is bound."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Exact relative evidence path within the acquired workspace target."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Responsible owner independently established by the host custody source."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Digest of the exact acquired evidence bytes."
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "committed"
      ],
      "properties": {
        "attempt": {
          "$ref": "#/$defs/evidence",
          "description": "Acquired immutable pre-effect evidence reference."
        },
        "committed": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evidence"
            }
          ],
          "description": "Acquired immutable committed result reference, if available."
        }
      }
    },
    "former_execplan": {
      "type": "object",
      "description": "Minimum shape of the admitted former execplan; unknown fields remain a coverage ambiguity.",
      "properties": {
        "canonical_core": {
          "type": [
            "object",
            "null"
          ],
          "description": "Lossless current owner canonical semantics, never attempt-only bookkeeping."
        },
        "kind": {
          "const": "planning-execplan/v1",
          "description": "Supported former Planning representation."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Established Planning subject identity."
        },
        "lifecycle": {
          "type": "string",
          "description": "Preserved current lifecycle."
        },
        "phase": {
          "type": "string",
          "description": "Preserved current phase."
        },
        "next_action": {
          "type": "string",
          "description": "Preserved current next_action."
        },
        "intent": {
          "type": "object",
          "description": "Former owner intent state."
        },
        "scope": {
          "type": "object",
          "description": "Former owner scope state."
        },
        "proof": {
          "type": "object",
          "description": "Former owner proof state."
        },
        "continuation": {
          "type": "object",
          "description": "Former owner continuation state."
        },
        "relationships": {
          "type": "object",
          "description": "Former owner relationships state."
        }
      },
      "required": [
        "kind",
        "id",
        "lifecycle",
        "phase",
        "next_action",
        "intent",
        "scope",
        "proof",
        "continuation",
        "relationships"
      ],
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "description": "Current material Planning state, excluding execution history.",
      "properties": {
        "canonical_core": {
          "type": [
            "object",
            "null"
          ],
          "description": "Lossless current owner canonical semantics, never attempt-only bookkeeping."
        },
        "outcome": {
          "type": "object",
          "description": "Preserved current outcome semantics."
        },
        "scope": {
          "type": "object",
          "description": "Preserved current scope semantics."
        },
        "dependencies": {
          "type": "object",
          "description": "Preserved current dependencies semantics."
        },
        "constraints": {
          "type": "object",
          "description": "Preserved current constraints semantics."
        },
        "frontier": {
          "type": "object",
          "description": "Preserved current frontier semantics."
        },
        "proof": {
          "type": "object",
          "description": "Preserved current proof semantics."
        },
        "handoff": {
          "type": "object",
          "description": "Preserved current handoff semantics."
        },
        "residual": {
          "type": "object",
          "description": "Preserved current residual semantics."
        }
      },
      "required": [
        "outcome",
        "scope",
        "dependencies",
        "constraints",
        "frontier",
        "proof",
        "handoff",
        "residual"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "description": "Planning current subject.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable subject identity across representation/source revisions."
        },
        "revision": {
          "type": "string",
          "description": "Material semantic revision, separate from source/currentness and attempts."
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Former display title."
        },
        "state": {
          "$ref": "#/$defs/state",
          "description": "Preserved material semantic state."
        }
      },
      "required": [
        "id",
        "revision",
        "label",
        "state"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "description": "Bounded reconciliation coverage, not task completion.",
      "properties": {
        "complete": {
          "type": "boolean",
          "description": "Whether this reader accounted for every current source field."
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Unaccounted source fields requiring Planning or agent judgement."
        },
        "omitted_history": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "History fields explicitly judged irrelevant by the acting agent or human."
        }
      },
      "required": [
        "complete",
        "ambiguities",
        "omitted_history"
      ],
      "additionalProperties": false
    },
    "reconciliation": {
      "type": "object",
      "description": "Committed same-owner Planning reconciliation, without historical continuation decisions.",
      "properties": {
        "kind": {
          "const": "agentic-planning/reconciliation/v1",
          "description": "Same-owner representation reconciliation."
        },
        "owner": {
          "const": "planning",
          "description": "Semantic custody stays with Planning."
        },
        "former_source": {
          "$ref": "#/$defs/evidence",
          "description": "Independently admitted exact former-source evidence."
        },
        "subject": {
          "$ref": "#/$defs/subject",
          "description": "Exact reconciled Planning identity and material revision."
        },
        "coverage": {
          "$ref": "#/$defs/coverage",
          "description": "Explicit unresolved source coverage."
        },
        "former_source_retained": {
          "const": true,
          "description": "This operation never deletes or hides the former source."
        }
      },
      "required": [
        "kind",
        "owner",
        "former_source",
        "subject",
        "coverage",
        "former_source_retained"
      ],
      "additionalProperties": false
    },
    "operation_arguments": {
      "type": "object",
      "description": "Planning-returned arguments; never caller-authored.",
      "properties": {
        "target": {
          "type": "string",
          "description": "Owner-derived target root."
        },
        "reconciliation": {
          "$ref": "#/$defs/reconciliation",
          "description": "Owner-derived exact selected semantic state and source binding."
        },
        "selection_transition": {
          "$ref": "#/$defs/selection_transition",
          "description": "Native selector currentness; no material identity or caller authority."
        }
      },
      "required": [
        "target",
        "reconciliation"
      ],
      "additionalProperties": false
    },
    "selection_transition": {
      "description": "Native release or human-authorised legacy transfer.",
      "oneOf": [
        {
          "$ref": "#/$defs/native_selection_transition"
        },
        {
          "$ref": "#/$defs/human_selection_transfer"
        }
      ]
    },
    "native_selection_transition": {
      "type": "object",
      "description": "Exact native selector release and destination.",
      "properties": {
        "prior_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Exact selector preimage."
        },
        "prior_custody": {
          "$ref": "#/$defs/custody",
          "properties": {
            "committed": {
              "$ref": "#/$defs/evidence",
              "description": "Committed admission required for release."
            }
          },
          "required": [
            "committed"
          ],
          "description": "Validated native Planning producer custody."
        },
        "selection": {
          "type": "object",
          "description": "Destination; separate custody.",
          "properties": {
            "kind": {
              "const": "agentic-planning/owner-selection/v1",
              "description": "Existing selector representation."
            },
            "mode": {
              "const": "local",
              "description": "Local selection scope."
            },
            "current_work_id": {
              "type": "string",
              "minLength": 1,
              "description": "Derived legacy selection_scope alias."
            },
            "selected_owner": {
              "type": "object",
              "description": "Destination owner.",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Destination Planning identity."
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact destination Planning source."
                }
              },
              "required": [
                "id",
                "ref"
              ],
              "additionalProperties": false
            },
            "selection_scope": {
              "type": "string",
              "minLength": 1,
              "description": "Advisory local cursor, never task identity."
            }
          },
          "required": [
            "kind",
            "mode",
            "selected_owner",
            "current_work_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "prior_sha256",
        "prior_custody",
        "selection"
      ],
      "additionalProperties": false
    },
    "human_selection_transfer": {
      "type": "object",
      "description": "One-shot human transfer from absent native custody.",
      "properties": {
        "prior_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Exact pre-transfer selector bytes."
        },
        "human_authorization": {
          "type": "object",
          "description": "Human answer; revalidate before transfer.",
          "properties": {
            "arguments": {
              "$ref": "#/$defs/continuation_request",
              "properties": {
                "answer": {
                  "const": "authorize-selector-transfer"
                }
              },
              "required": [
                "answer",
                "transfer_revision"
              ]
            }
          },
          "required": [
            "arguments"
          ]
        },
        "selection": {
          "type": "object",
          "description": "Legacy selector plus custody only."
        }
      },
      "required": [
        "prior_sha256",
        "human_authorization",
        "selection"
      ],
      "additionalProperties": false
    },
    "posture_request": {
      "type": "object",
      "properties": {
        "task_relation": {
          "const": "independent"
        },
        "answer": {
          "enum": [
            "direct",
            "planned"
          ]
        }
      },
      "required": [
        "task_relation",
        "answer"
      ],
      "additionalProperties": false
    }
  }
}
