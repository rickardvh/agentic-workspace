{
  "classification": "metadata-refresh",
  "command_surface": {
    "command": "evaluation",
    "format_option": "format",
    "subcommand": "authority-refresh"
  },
  "effects": {
    "destructive": false,
    "idempotent": true,
    "read_only": false,
    "requires_preflight_gate": false,
    "writes_repo_state": false
  },
  "guards": [
    "Exactly one current assignment is required.",
    "The public proof receipt must be admitted and passed.",
    "Caller dictionaries cannot create or override authority."
  ],
  "id": "evaluation.authority-refresh",
  "inputs": [
    {
      "name": "target",
      "required": false,
      "schema_ref": "schemas/evaluation_authority_refresh_input.schema.json",
      "source": "cli-option"
    },
    {
      "name": "evaluation_id",
      "required": true,
      "source": "cli-option"
    },
    {
      "name": "format",
      "required": false,
      "source": "cli-option"
    }
  ],
  "ir_plan": {
    "status": "partial",
    "steps": [
      {
        "description": "Resolve the target root.",
        "id": "resolve_root",
        "uses": "workspace.target-root.resolve"
      },
      {
        "description": "Refresh the authority phase used by observation append.",
        "id": "refresh",
        "uses": "evaluation.observation.append"
      },
      {
        "description": "Emit refresh result.",
        "id": "emit_output",
        "uses": "output.emit"
      }
    ],
    "summary": "Generated command packages invoke the runtime-owned authority refresh transition."
  },
  "locality": {
    "network": "forbidden",
    "outside_repo_writes": "forbidden",
    "requires_repo": true
  },
  "migration_status": "runtime-consumed",
  "output": {
    "kind": "json",
    "schema_ref": "schemas/evaluation_authority_refresh_result.schema.json"
  },
  "proof": [
    "evaluation authority tests",
    "CLI/Python/TypeScript generated client parity"
  ],
  "reads": [
    {
      "required": true,
      "surface": ".agentic-workspace/planning/assignments/*.assignment.json"
    },
    {
      "required": true,
      "surface": ".agentic-workspace/local/proof-receipts/last.json"
    },
    {
      "required": true,
      "surface": "git HEAD and scoped status"
    }
  ],
  "schema_version": "agentic-workspace/operation/v1",
  "steps": [
    {
      "description": "Resolve the target root.",
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve"
    },
    {
      "description": "Resolve and persist the authority phase used by observation append.",
      "id": "refresh",
      "uses": "evaluation.observation.append"
    },
    {
      "description": "Emit refresh result.",
      "id": "emit_output",
      "uses": "output.emit"
    }
  ],
  "summary": "Refresh evaluation observation authority from the single live assignment and admitted public proof receipt.",
  "writes": [
    {
      "required": true,
      "surface": ".agentic-workspace/local/evaluations/<evaluation-id>.authority.json",
      "when": "live authority is unambiguous and current"
    }
  ]
}
