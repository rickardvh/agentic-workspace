{
  "classification": "lifecycle-mutation",
  "command_surface": {
    "command": "assignment",
    "format_option": "format",
    "subcommand": "dispatch"
  },
  "effects": {
    "destructive": false,
    "idempotent": false,
    "read_only": false,
    "requires_preflight_gate": false,
    "writes_repo_state": true
  },
  "guards": [
    "Consume one revision-bound canonical assignment and its configured automatic transport; never rerank the selected target.",
    "A failed or unavailable automatic transport remains blocked and cannot silently fall back to local implementation.",
    "Returned work is untrusted evidence in received/awaiting-admission until normal admission, integration, proof, and reconciliation complete."
  ],
  "id": "assignment.dispatch",
  "inputs": [
    {
      "name": "configuration_revision",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "configuration_id",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "target",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "format",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "assignment_id",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "assignment_revision",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "run_id",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "target_name",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "transport",
      "required": true,
      "source": "cli-option"
    },
    {
      "name": "task",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "changed",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "dry_run",
      "required": false,
      "source": "cli-option"
    }
  ],
  "intent": "Execute the configured automatic transport for one binding non-local assignment without creating a second assignment or authority owner.",
  "ir_plan": {
    "status": "complete",
    "steps": [
      {
        "description": "resolve_root",
        "id": "resolve_root",
        "outputs": [
          "target_root"
        ],
        "uses": "workspace.target-root.resolve"
      },
      {
        "description": "dispatch_assignment",
        "id": "dispatch_assignment",
        "outputs": [
          "result"
        ],
        "uses": "assignment.lifecycle.apply"
      },
      {
        "description": "emit_output",
        "id": "emit_output",
        "outputs": [
          "emitted"
        ],
        "uses": "output.emit"
      }
    ]
  },
  "locality": {
    "network": "allowed",
    "outside_repo_writes": "forbidden",
    "requires_repo": true
  },
  "migration_status": "runtime-consumed",
  "output": {
    "kind": "text-or-json",
    "schema_ref": "schemas/assignment_lifecycle_result.schema.json"
  },
  "proof": [
    "assignment dispatch tests prove revision binding, automatic transport execution, failure closure, and untrusted return placement",
    "assignment.dispatch.process",
    "operation contract validates against operation.schema.json"
  ],
  "reads": [
    {
      "description": "checked-in Planning assignment authority resolved by assignment id",
      "required": true,
      "surface": ".agentic-workspace/planning/assignments/<assignment-id>.assignment.json"
    },
    {
      "description": "configured target adapter carried by the canonical assignment identity",
      "required": true,
      "surface": "assignment.assignment_gate.dispatch_adapter"
    }
  ],
  "schema_version": "agentic-workspace/operation/v1",
  "steps": [
    {
      "description": "Resolve the target repository root.",
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve"
    },
    {
      "description": "Execute the configured automatic transport for the current assignment revision.",
      "id": "dispatch_assignment",
      "uses": "assignment.lifecycle.apply"
    },
    {
      "description": "Emit the dispatch and return-capture result.",
      "id": "emit_output",
      "uses": "output.emit"
    }
  ],
  "summary": "Execute one configured automatic assignment transport and capture its return for admission.",
  "writes": [
    {
      "description": "materialized assignment authority when invoked before it exists",
      "required": false,
      "surface": ".agentic-workspace/planning/assignments/",
      "when": "the live canonical assignment is not yet materialized"
    },
    {
      "description": "dispatch receipt and returned evidence",
      "required": true,
      "surface": ".agentic-workspace/local/assignment-runs/<run-id>/",
      "when": "automatic transport executes"
    }
  ]
}
