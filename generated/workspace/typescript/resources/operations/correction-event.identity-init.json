{
  "classification": "lifecycle-mutation",
  "command_surface": {
    "command": "correction-event",
    "format_option": "format",
    "subcommand": "identity-init"
  },
  "effects": {
    "destructive": false,
    "idempotent": true,
    "read_only": false,
    "requires_preflight_gate": false,
    "writes_repo_state": false
  },
  "guards": [
    "The target profile must resolve uniquely before a target id is proposed.",
    "Generated ids are collision-checked against every configured stable target id.",
    "An optional config digest provides compare-and-swap admission.",
    "The operation never writes checked-in target identity residue."
  ],
  "id": "correction-event.identity-init",
  "inputs": [
    {
      "name": "target",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "format",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "target_profile",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "target_id",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "expected_config_digest",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "dry_run",
      "required": false,
      "source": "cli-option"
    }
  ],
  "intent": "Make correction-event, target-guidance, and suitability identity constructible without inventing a target id or adding checked-in target residue.",
  "ir_plan": {
    "status": "complete",
    "steps": [
      {
        "description": "resolve_root",
        "id": "resolve_root",
        "outputs": [
          "target_root"
        ],
        "uses": "workspace.target-root.resolve"
      },
      {
        "description": "initialize_identity",
        "id": "initialize_identity",
        "outputs": [
          "result"
        ],
        "uses": "correction.event.apply"
      },
      {
        "description": "emit_output",
        "id": "emit_output",
        "outputs": [
          "emitted"
        ],
        "uses": "output.emit"
      }
    ]
  },
  "locality": {
    "network": "forbidden",
    "outside_repo_writes": "forbidden",
    "requires_repo": true
  },
  "migration_status": "runtime-consumed",
  "output": {
    "kind": "text-or-json",
    "schema_ref": "schemas/correction_event_result.schema.json"
  },
  "proof": [
    "Generated Python and TypeScript clients exercise dry-run, apply, idempotency, collision, and rename-continuity behavior.",
    "Config projection exposes the same repair operation before correction submission."
  ],
  "reads": [
    {
      "description": "Configured target profiles and current target.",
      "required": false,
      "surface": ".agentic-workspace/config.local.toml"
    }
  ],
  "schema_version": "agentic-workspace/operation/v1",
  "steps": [
    {
      "description": "Resolve target root.",
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve"
    },
    {
      "description": "Plan or apply the local target identity initialization.",
      "id": "initialize_identity",
      "uses": "correction.event.apply"
    },
    {
      "description": "Emit result.",
      "id": "emit_output",
      "uses": "output.emit"
    }
  ],
  "summary": "Initialize one stable configured target identity in ignored local config.",
  "writes": [
    {
      "description": "One stable target_id in ignored local configuration.",
      "required": false,
      "surface": ".agentic-workspace/config.local.toml",
      "when": "not a dry run and the profile has no stable id"
    }
  ]
}
