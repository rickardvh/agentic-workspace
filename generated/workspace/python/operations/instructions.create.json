{
  "classification": "lifecycle-mutation",
  "command_surface": {
    "command": "instructions",
    "format_option": "format",
    "subcommand": "new"
  },
  "effects": {
    "destructive": false,
    "idempotent": false,
    "read_only": false,
    "requires_preflight_gate": false,
    "writes_repo_state": true
  },
  "guards": [
    "Reject invalid names and repository-relative path patterns.",
    "Never overwrite an existing instruction file."
  ],
  "id": "instructions.create",
  "inputs": [
    {
      "name": "target",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "format",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "name",
      "required": true,
      "source": "cli-option"
    },
    {
      "name": "paths",
      "required": false,
      "source": "cli-option"
    }
  ],
  "ir_plan": {
    "status": "complete",
    "steps": [
      {
        "description": "resolve_root",
        "id": "resolve_root",
        "outputs": [
          "target_root"
        ],
        "uses": "workspace.target-root.resolve"
      },
      {
        "description": "execute_instruction_operation",
        "id": "execute_instruction_operation",
        "outputs": [
          "result"
        ],
        "uses": "instructions.execute"
      },
      {
        "description": "emit_output",
        "id": "emit_output",
        "outputs": [
          "emitted"
        ],
        "uses": "output.emit"
      }
    ]
  },
  "locality": {
    "network": "forbidden",
    "outside_repo_writes": "forbidden",
    "requires_repo": false
  },
  "migration_status": "runtime-consumed",
  "output": {
    "kind": "text-or-json",
    "schema_ref": "schemas/scoped_instruction_operation_result.schema.json"
  },
  "proof": [
    "instructions.create.process",
    "generated Python and TypeScript operation clients preserve the no-overwrite boundary"
  ],
  "reads": [
    {
      "required": false,
      "surface": ".agentic-workspace/instructions/<name>.md"
    }
  ],
  "schema_version": "agentic-workspace/operation/v1",
  "steps": [
    {
      "description": "Resolve the target root.",
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve"
    },
    {
      "description": "Create through the no-overwrite scoped instruction semantic owner.",
      "id": "execute_instruction_operation",
      "uses": "instructions.execute"
    },
    {
      "description": "Emit the instruction result.",
      "id": "emit_output",
      "uses": "output.emit"
    }
  ],
  "summary": "Create one scoped Markdown instruction without overwriting an existing file.",
  "writes": [
    {
      "description": "one new scoped instruction scaffold",
      "required": true,
      "surface": ".agentic-workspace/instructions/<name>.md",
      "when": "the destination does not exist"
    }
  ]
}
