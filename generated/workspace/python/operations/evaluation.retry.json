{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "evaluation.retry",
  "command_surface": {
    "command": "evaluation",
    "format_option": "format",
    "subcommand": "retry"
  },
  "summary": "Return the current retryable external delivery request for failed or pending sinks.",
  "classification": "read-only-report",
  "inputs": [
    {
      "name": "target",
      "source": "cli-option",
      "required": false,
      "schema_ref": "schemas/evaluation_report_delivery_input.schema.json"
    },
    {
      "name": "evaluation_id",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "sink_id",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "format",
      "source": "cli-option",
      "required": false
    }
  ],
  "output": {
    "kind": "json",
    "schema_ref": "schemas/evaluation_report_delivery_result.schema.json",
    "description": "Retry projection for current delivery request."
  },
  "effects": {
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "writes_repo_state": false,
    "requires_preflight_gate": false
  },
  "locality": {
    "requires_repo": true,
    "network": "forbidden",
    "outside_repo_writes": "forbidden"
  },
  "reads": [
    {
      "surface": ".agentic-workspace/local/evaluations/<evaluation-id>.external-deliveries.json",
      "required": false
    }
  ],
  "writes": [],
  "steps": [
    {
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve",
      "description": "Resolve the target root."
    },
    {
      "id": "retry",
      "uses": "evaluation.delivery.retry",
      "description": "Return current pending/failed sinks and request identity for adapter retry."
    },
    {
      "id": "emit_output",
      "uses": "output.emit",
      "description": "Emit retry projection."
    }
  ],
  "guards": [
    "Retry projection does not claim execution.",
    "A fresh producer adapter receipt is required before status can become delivered."
  ],
  "proof": [
    "evaluation unit tests",
    "operation contract validates against operation.schema.json"
  ],
  "migration_status": "runtime-consumed"
}
