{
  "classification": "local-record-append",
  "command_surface": {
    "command": "instructions",
    "format_option": "format",
    "subcommand": "select-route"
  },
  "effects": {
    "destructive": false,
    "idempotent": true,
    "read_only": false,
    "requires_preflight_gate": false,
    "writes_repo_state": false
  },
  "guards": [
    "Reject stale route-source revisions and mismatched current work.",
    "Route selection supplies applicability only and grants no authority."
  ],
  "id": "instructions.route-select",
  "inputs": [
    {
      "name": "target",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "format",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "posture",
      "required": true,
      "source": "cli-option"
    },
    {
      "name": "route",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "current_work_id",
      "required": false,
      "source": "cli-option"
    },
    {
      "name": "expected_source_revision",
      "required": true,
      "source": "cli-option"
    },
    {
      "name": "dry_run",
      "required": false,
      "source": "cli-option"
    }
  ],
  "ir_plan": {
    "status": "complete",
    "steps": [
      {
        "description": "resolve_root",
        "id": "resolve_root",
        "outputs": [
          "target_root"
        ],
        "uses": "workspace.target-root.resolve"
      },
      {
        "description": "execute_instruction_operation",
        "id": "execute_instruction_operation",
        "outputs": [
          "result"
        ],
        "uses": "instructions.execute"
      },
      {
        "description": "emit_output",
        "id": "emit_output",
        "outputs": [
          "emitted"
        ],
        "uses": "output.emit"
      }
    ]
  },
  "locality": {
    "network": "forbidden",
    "outside_repo_writes": "forbidden",
    "requires_repo": true
  },
  "migration_status": "runtime-consumed",
  "output": {
    "kind": "json",
    "schema_ref": "schemas/scoped_instruction_operation_result.schema.json"
  },
  "proof": [
    "instructions.route-select.process",
    "selected, none, unresolved, stale, replay, and current-work-switch fixtures"
  ],
  "reads": [
    {
      "required": true,
      "surface": "canonical skill REGISTRY.json files"
    }
  ],
  "schema_version": "agentic-workspace/operation/v1",
  "steps": [
    {
      "description": "Resolve the target root.",
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve"
    },
    {
      "description": "Validate and write the authority-neutral route fact.",
      "id": "execute_instruction_operation",
      "uses": "instructions.execute"
    },
    {
      "description": "Emit the guarded selection result.",
      "id": "emit_output",
      "uses": "output.emit"
    }
  ],
  "summary": "Select current-work-bound semantic task-route applicability facts with source revision guards.",
  "writes": [
    {
      "required": true,
      "surface": ".agentic-workspace/local/current-task-routes.json",
      "when": "revision and current-work guards pass and dry_run is false"
    }
  ]
}
