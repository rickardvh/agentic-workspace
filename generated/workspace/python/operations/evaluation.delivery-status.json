{
  "schema_version": "agentic-workspace/operation/v1",
  "id": "evaluation.delivery-status",
  "command_surface": {
    "command": "evaluation",
    "format_option": "format",
    "subcommand": "delivery-status"
  },
  "summary": "Project per-sink report delivery status from local compilation and admitted producer receipts.",
  "classification": "read-only-report",
  "inputs": [
    {
      "name": "target",
      "source": "cli-option",
      "required": false,
      "schema_ref": "schemas/evaluation_report_delivery_input.schema.json"
    },
    {
      "name": "evaluation_id",
      "source": "cli-option",
      "required": true
    },
    {
      "name": "explicit",
      "source": "cli-option",
      "required": false
    },
    {
      "name": "format",
      "source": "cli-option",
      "required": false
    }
  ],
  "output": {
    "kind": "json",
    "schema_ref": "schemas/evaluation_report_delivery_result.schema.json",
    "description": "Current delivery status projection."
  },
  "effects": {
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "writes_repo_state": false,
    "requires_preflight_gate": false
  },
  "locality": {
    "requires_repo": true,
    "network": "forbidden",
    "outside_repo_writes": "forbidden"
  },
  "reads": [
    {
      "surface": ".agentic-workspace/local/evaluations/<evaluation-id>.report-deliveries.json",
      "required": false
    },
    {
      "surface": ".agentic-workspace/local/evaluations/<evaluation-id>.external-deliveries.json",
      "required": false
    }
  ],
  "writes": [],
  "steps": [
    {
      "id": "resolve_root",
      "uses": "workspace.target-root.resolve",
      "description": "Resolve the target root."
    },
    {
      "id": "project",
      "uses": "evaluation.delivery.status",
      "description": "Resolve current delivery request and project each sink from stored receipts."
    },
    {
      "id": "emit_output",
      "uses": "output.emit",
      "description": "Emit status."
    }
  ],
  "guards": [
    "Caller-supplied success flags are ignored.",
    "Only admitted producer-owned receipts can make a sink delivered."
  ],
  "proof": [
    "evaluation unit tests",
    "operation contract validates against operation.schema.json"
  ],
  "migration_status": "runtime-consumed"
}
